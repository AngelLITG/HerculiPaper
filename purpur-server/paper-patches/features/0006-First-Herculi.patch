+package io.multipaper.herculi.broadcast;
+
+import java.util.concurrent.atomic.AtomicLong;
+
+/**
+ * Minimal metrics scaffold for threaded broadcasting (default-off).
+ * Safe to reference from anywhere; no external deps.
+ */
+public final class BroadcastMetrics {
+    private BroadcastMetrics() {}
+
+    public static final AtomicLong activeQueues = new AtomicLong();
+    public static final AtomicLong enqueuedBatches = new AtomicLong();
+    public static final AtomicLong dequeuedBatches = new AtomicLong();
+    public static final AtomicLong droppedBatchesOverflow = new AtomicLong();
+    public static final AtomicLong droppedBatchesTimeout = new AtomicLong();
+
+    public static long getActiveQueues() { return activeQueues.get(); }
+    public static long getEnqueuedBatches() { return enqueuedBatches.get(); }
+    public static long getDequeuedBatches() { return dequeuedBatches.get(); }
+    public static long getDroppedBatchesOverflow() { return droppedBatchesOverflow.get(); }
+    public static long getDroppedBatchesTimeout() { return droppedBatchesTimeout.get(); }
+}
diff --git a/src/main/java/io/multipaper/herculi/broadcast/BroadcastRegistry.java b/src/main/java/io/multipaper/herculi/broadcast/BroadcastRegistry.java
new file mode 100644
index 0000000000000000000000000000000000000000..93f3e76e3d50a60d9032b0d9ba20e19b6e926b7f
--- /dev/null
+++ b/src/main/java/io/multipaper/herculi/broadcast/BroadcastRegistry.java
@@ -0,0 +1,33 @@
+package io.multipaper.herculi.broadcast;
+
+import java.util.Objects;
+
+/**
+ * Global access to the broadcasting queue manager. In production this would be
+ * constructed from configuration and lifecycle-managed during server start/stop.
+ * For now, it's a simple holder (default-off wiring expected by caller).
+ */
+public final class BroadcastRegistry {
+    private BroadcastRegistry() {}
+
+    private static volatile RecipientQueueManager manager;
+    private static volatile boolean enabled;
+    private static volatile int drainBudget = 64;
+
+    public static void init(boolean isEnabled, int maxQueuesTotal, int maxBatchesPerQueue, RecipientQueue.DropPolicy dropPolicy, int drainBudgetPerTick) {
+        enabled = isEnabled;
+        drainBudget = Math.max(1, drainBudgetPerTick);
+        manager = new RecipientQueueManager(maxQueuesTotal, maxBatchesPerQueue, dropPolicy);
+    }
+
+    public static RecipientQueueManager manager() {
+        return Objects.requireNonNullElseGet(manager, () -> {
+            // lazy default (very conservative)
+            manager = new RecipientQueueManager(1024, 32, RecipientQueue.DropPolicy.DROP);
+            return manager;
+        });
+    }
+
+    public static boolean enabled() { return enabled; }
+    public static int drainBudget() { return drainBudget; }
+}
diff --git a/src/main/java/io/multipaper/herculi/broadcast/RecipientQueue.java b/src/main/java/io/multipaper/herculi/broadcast/RecipientQueue.java
new file mode 100644
index 0000000000000000000000000000000000000000..ce071eb2f543d4352e899c56903b2613fde50738
--- /dev/null
+++ b/src/main/java/io/multipaper/herculi/broadcast/RecipientQueue.java
@@ -0,0 +1,86 @@
+package io.multipaper.herculi.broadcast;
+
+import net.minecraft.network.protocol.Packet;
+
+import java.util.ArrayDeque;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Objects;
+import java.util.concurrent.atomic.AtomicInteger;
+
+/**
+ * Bounded per-recipient, per-(world,chunk) queue for packet batches.
+ * Default-off scaffolding; no runtime wiring yet.
+ */
+public final class RecipientQueue {
+    public enum DropPolicy { COALESCE, FALLBACK_TO_MAIN, DROP }
+
+    public static final class RecipientBatch {
+        public final List<Packet<?>> packets;
+        public final long createdAtNanos;
+        public RecipientBatch(List<Packet<?>> packets) {
+            this.packets = packets == null ? List.of() : List.copyOf(packets);
+            this.createdAtNanos = System.nanoTime();
+        }
+        public static RecipientBatch single(Packet<?> pkt) {
+            return new RecipientBatch(java.util.List.of(pkt));
+        }
+    }
+
+    private final RecipientQueueKey key;
+    private final ArrayDeque<RecipientBatch> deque;
+    private final int maxBatches;
+    private final DropPolicy dropPolicy;
+    private final AtomicInteger size = new AtomicInteger();
+
+    public RecipientQueue(RecipientQueueKey key, int maxBatches, DropPolicy dropPolicy) {
+        this.key = Objects.requireNonNull(key, "key");
+        this.deque = new ArrayDeque<>(Math.max(1, maxBatches));
+        this.maxBatches = Math.max(1, maxBatches);
+        this.dropPolicy = dropPolicy == null ? DropPolicy.DROP : dropPolicy;
+    }
+
+    public RecipientQueueKey key() { return key; }
+
+    public int size() { return size.get(); }
+
+    public boolean isEmpty() { return size() == 0; }
+
+    /** Offer a batch; returns true if enqueued, false if dropped. */
+    public boolean offer(RecipientBatch batch) {
+        if (batch == null) return true; // nothing to enqueue
+        synchronized (deque) {
+            if (deque.size() >= maxBatches) {
+                switch (dropPolicy) {
+                    case COALESCE:
+                        // Simple coalesce: drop oldest to make room for newest
+                        deque.pollFirst();
+                        BroadcastMetrics.droppedBatchesOverflow.incrementAndGet();
+                        break;
+                    case FALLBACK_TO_MAIN:
+                        // For scaffolding, treat same as DROP (actual fallback will be handled by caller)
+                    case DROP:
+                    default:
+                        BroadcastMetrics.droppedBatchesOverflow.incrementAndGet();
+                        return false;
+                }
+            }
+            deque.addLast(batch);
+            size.incrementAndGet();
+            BroadcastMetrics.enqueuedBatches.incrementAndGet();
+            return true;
+        }
+    }
+
+    /** Poll next batch or null. */
+    public RecipientBatch poll() {
+        synchronized (deque) {
+            RecipientBatch b = deque.pollFirst();
+            if (b != null) {
+                size.decrementAndGet();
+                BroadcastMetrics.dequeuedBatches.incrementAndGet();
+            }
+            return b;
+        }
+    }
+}
diff --git a/src/main/java/io/multipaper/herculi/broadcast/RecipientQueueKey.java b/src/main/java/io/multipaper/herculi/broadcast/RecipientQueueKey.java
new file mode 100644
index 0000000000000000000000000000000000000000..ee4afdce6a849919fffd22b290248ef2d8400b6c
--- /dev/null
+++ b/src/main/java/io/multipaper/herculi/broadcast/RecipientQueueKey.java
@@ -0,0 +1,31 @@
+package io.multipaper.herculi.broadcast;
+
+import java.util.Objects;
+import java.util.UUID;
+
+public final class RecipientQueueKey {
+    public final UUID playerUuid;
+    public final String worldKey; // dimension identifier
+    public final int chunkX;
+    public final int chunkZ;
+
+    public RecipientQueueKey(UUID playerUuid, String worldKey, int chunkX, int chunkZ) {
+        this.playerUuid = playerUuid;
+        this.worldKey = worldKey;
+        this.chunkX = chunkX;
+        this.chunkZ = chunkZ;
+    }
+
+    @Override
+    public boolean equals(Object o) {
+        if (this == o) return true;
+        if (!(o instanceof RecipientQueueKey)) return false;
+        RecipientQueueKey that = (RecipientQueueKey) o;
+        return chunkX == that.chunkX && chunkZ == that.chunkZ && Objects.equals(playerUuid, that.playerUuid) && Objects.equals(worldKey, that.worldKey);
+    }
+
+    @Override
+    public int hashCode() {
+        return Objects.hash(playerUuid, worldKey, chunkX, chunkZ);
+    }
+}
diff --git a/src/main/java/io/multipaper/herculi/broadcast/RecipientQueueManager.java b/src/main/java/io/multipaper/herculi/broadcast/RecipientQueueManager.java
new file mode 100644
index 0000000000000000000000000000000000000000..f4f2acbbb9972af346ad3c9a4715dc8cd4044fa8
--- /dev/null
+++ b/src/main/java/io/multipaper/herculi/broadcast/RecipientQueueManager.java
@@ -0,0 +1,121 @@
+package io.multipaper.herculi.broadcast;
+
+import java.util.Objects;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.ConcurrentMap;
+
+/**
+ * Registry of per-recipient queues. Default-off scaffolding.
+ */
+public final class RecipientQueueManager {
+
+    public static final class OfferResult {
+        public final boolean enqueued;
+        public final boolean dropped;
+        public final boolean createdQueue;
+        private OfferResult(boolean enqueued, boolean dropped, boolean createdQueue) {
+            this.enqueued = enqueued;
+            this.dropped = dropped;
+            this.createdQueue = createdQueue;
+        }
+        public static OfferResult enqueued(boolean created) { return new OfferResult(true, false, created); }
+        public static OfferResult dropped() { return new OfferResult(false, true, false); }
+    }
+
+    private final ConcurrentMap<RecipientQueueKey, RecipientQueue> queues = new ConcurrentHashMap<>();
+
+    private final int maxQueuesTotal;
+    private final int maxBatchesPerQueue;
+    private final RecipientQueue.DropPolicy dropPolicy;
+
+    public RecipientQueueManager(int maxQueuesTotal, int maxBatchesPerQueue, RecipientQueue.DropPolicy dropPolicy) {
+        this.maxQueuesTotal = Math.max(1, maxQueuesTotal);
+        this.maxBatchesPerQueue = Math.max(1, maxBatchesPerQueue);
+        this.dropPolicy = dropPolicy == null ? RecipientQueue.DropPolicy.DROP : dropPolicy;
+    }
+
+    public RecipientQueue getOrCreate(RecipientQueueKey key) {
+        Objects.requireNonNull(key, "key");
+        RecipientQueue existing = queues.get(key);
+        if (existing != null) return existing;
+        if (queues.size() >= maxQueuesTotal) {
+            // refuse to grow; caller must fallback
+            return null;
+        }
+        RecipientQueue created = new RecipientQueue(key, maxBatchesPerQueue, dropPolicy);
+        RecipientQueue prev = queues.putIfAbsent(key, created);
+        if (prev == null) {
+            BroadcastMetrics.activeQueues.incrementAndGet();
+            return created;
+        }
+        return prev;
+    }
+
+    public void remove(RecipientQueueKey key) {
+        RecipientQueue q = queues.remove(key);
+        if (q != null) {
+            BroadcastMetrics.activeQueues.decrementAndGet();
+        }
+    }
+
+    public OfferResult offer(RecipientQueueKey key, RecipientQueue.RecipientBatch batch) {
+        RecipientQueue q = queues.get(key);
+        boolean created = false;
+        if (q == null) {
+            q = getOrCreate(key);
+            created = q != null;
+        }
+        if (q == null) {
+            return OfferResult.dropped();
+        }
+        boolean ok = q.offer(batch);
+        return ok ? OfferResult.enqueued(created) : OfferResult.dropped();
+    }
+
+    public RecipientQueue.RecipientBatch poll(RecipientQueueKey key) {
+        RecipientQueue q = queues.get(key);
+        return q == null ? null : q.poll();
+    }
+
+    public int size() { return queues.size(); }
+
+    /** Approximate total pending batches across all queues. */
+    public int pendingSize() {
+        int total = 0;
+        for (RecipientQueue q : queues.values()) {
+            total += q.size();
+        }
+        return total;
+    }
+
+    /**
+     * Drain up to maxBatches across queues, invoking the sender for each batch.
+     * The sender should perform the actual packet sends and return true if successful.
+     */
+    public int drainOnMain(java.util.function.BiFunction<RecipientQueueKey, RecipientQueue.RecipientBatch, Boolean> sender, int maxBatches) {
+        if (sender == null || maxBatches <= 0) return 0;
+        // Fairness budget (optional)
+        int budget = maxBatches;
+        try {
+            budget = io.multipaper.herculi.fairness.Fairness.tryConsume(io.multipaper.herculi.fairness.Fairness.Category.BROADCAST_DRAIN, maxBatches);
+        } catch (Throwable ignored) {}
+        int sent = 0;
+        for (var entry : queues.entrySet()) {
+            if (sent >= budget) break;
+            RecipientQueueKey key = entry.getKey();
+            RecipientQueue q = entry.getValue();
+            if (q == null || q.isEmpty()) continue;
+            RecipientQueue.RecipientBatch batch;
+            while (sent < budget && q != null && (batch = q.poll()) != null) {
+                try {
+                    if (Boolean.TRUE.equals(sender.apply(key, batch))) {
+                        sent++;
+                    }
+                } catch (Throwable t) {
+                    // ignore send failure for scaffolding
+                }
+            }
+        }
+        return sent;
+    }
+}
diff --git a/src/main/java/io/multipaper/herculi/chunk/HerculiChunkPipeline.java b/src/main/java/io/multipaper/herculi/chunk/HerculiChunkPipeline.java
new file mode 100644
index 0000000000000000000000000000000000000000..c3ff96cab344f74b0df4d17439e4627c7cdd77e3
--- /dev/null
+++ b/src/main/java/io/multipaper/herculi/chunk/HerculiChunkPipeline.java
@@ -0,0 +1,63 @@
+package io.multipaper.herculi.chunk;
+
+/**
+ * Phase 1 scaffolding for the world/chunk async pipeline. This placeholder will
+ * later coordinate async read/write, generation, and lighting stages while
+ * respecting region ownership and thread-affinity. For now, it contains no
+ * behavior and only exists to establish compile-time anchors.
+ */
+public final class HerculiChunkPipeline {
+
+    private static final HerculiChunkPipeline INSTANCE = new HerculiChunkPipeline();
+
+    public static HerculiChunkPipeline instance() {
+        return INSTANCE;
+    }
+
+    private HerculiChunkPipeline() {}
+
+    // Inflight guardrails
+    private static volatile java.util.concurrent.Semaphore inflight;
+    private static java.util.concurrent.Semaphore semaphore() {
+        java.util.concurrent.Semaphore s = inflight;
+        if (s != null) return s;
+        synchronized (HerculiChunkPipeline.class) {
+            if (inflight == null) {
+                int permits = Math.max(1, io.multipaper.herculi.config.HerculiConfig.instance().chunkIoMaxInflight());
+                inflight = new java.util.concurrent.Semaphore(permits);
+            }
+            return inflight;
+        }
+    }
+
+    // --- Minimal scaffold API ---
+    // For now, these are config-gated NO-OPs that demonstrate how region-affine
+    // execution will be used for chunk operations.
+
+    public java.util.concurrent.CompletableFuture<Void> prefetchChunk(final net.minecraft.server.level.ServerLevel level,
+                                                                      final net.minecraft.world.level.ChunkPos pos) {
+        final io.multipaper.herculi.config.HerculiConfig cfg = io.multipaper.herculi.config.HerculiConfig.instance();
+        if (!cfg.threadingEnabled() || !cfg.chunkIoEnabled()) {
+            return java.util.concurrent.CompletableFuture.completedFuture(null);
+        }
+        final java.util.concurrent.Semaphore sem = semaphore();
+        if (!sem.tryAcquire()) {
+            // Respect inflight cap; skip prefetch when saturated
+            return java.util.concurrent.CompletableFuture.completedFuture(null);
+        }
+        final io.multipaper.herculi.region.RegionKey key = io.multipaper.herculi.region.RegionKey.of(level.dimension(),
+            io.multipaper.herculi.region.RegionPos.forChunk(pos));
+        final io.multipaper.herculi.threading.RegionExecutor exec =
+            io.multipaper.herculi.threading.HerculiRegionExecutors.executorFor(key);
+        final java.util.concurrent.CompletableFuture<Void> cf = new java.util.concurrent.CompletableFuture<>();
+        exec.execute(() -> {
+            // Placeholder: real implementation will schedule async IO and stage work
+            try {
+                cf.complete(null);
+            } finally {
+                sem.release();
+            }
+        });
+        return cf;
+    }
+}
