+        // Instrumentation toggles (default-off)
+        m.put("instrumentation.unload.metrics_enabled", "false");
+        m.put("instrumentation.block_entities.metrics_enabled", "false");
+        // Threaded broadcasting (default-off)
+        m.put("broadcasting.threaded.enabled", "false");
+        m.put("broadcasting.threaded.maxBatchesPerQueue", "16");
+        m.put("broadcasting.threaded.perTickDrainBudget", "4");
+        // Tracking caps (default-off)
+        m.put("tracking.max_trackers_per_entity", "0");
