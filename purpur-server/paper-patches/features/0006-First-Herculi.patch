+++ b/src/main/java/io/multipaper/herculi/instrumentation/HerculiProfiler.java
@@ -0,0 +1,71 @@
+package io.multipaper.herculi.instrumentation;
+
+/**
+ * Simple profiling scaffold. Optionally integrates with JFR when available.
+ */
+public final class HerculiProfiler {
+    private static final HerculiProfiler INSTANCE = new HerculiProfiler();
+    public static HerculiProfiler instance() { return INSTANCE; }
+
+    private volatile boolean running;
+    private volatile long startMillis;
+    private volatile long lastDurationMillis;
+
+    // JFR support (optional)
+    private Object jfrRecording; // avoid hard dependency at compile sites
+
+    private HerculiProfiler() {}
+
+    public synchronized String start(boolean withJfr) {
+        if (this.running) {
+            return "Profiling already running (" + elapsedMillis() + " ms).";
+        }
+        this.running = true;
+        this.startMillis = System.currentTimeMillis();
+        this.lastDurationMillis = 0L;
+
+        if (withJfr) {
+            try {
+                // reflective use of jdk.jfr.Recording to avoid compile/link issues in custom toolchains
+                Class<?> recCls = Class.forName("jdk.jfr.Recording");
+                Object rec = recCls.getConstructor().newInstance();
+                recCls.getMethod("start").invoke(rec);
+                this.jfrRecording = rec;
+            } catch (Throwable ignored) {
+                // JFR not available or failed; continue without it
+                this.jfrRecording = null;
+                return "Profiling started (JFR unavailable).";
+            }
+            return "Profiling started with JFR.";
+        }
+        return "Profiling started.";
+    }
+
+    public synchronized String stop() {
+        if (!this.running) {
+            return "Profiling not running.";
+        }
+        this.running = false;
+        this.lastDurationMillis = System.currentTimeMillis() - this.startMillis;
+
+        if (this.jfrRecording != null) {
+            try {
+                // dump to default filename in server working dir
+                Class<?> recCls = this.jfrRecording.getClass();
+                // jdk.jfr.Recording#dump(Path) — we try to dump to a timestamped file
+                java.nio.file.Path out = java.nio.file.Paths.get("herculi-profile-" + this.startMillis + ".jfr");
+                recCls.getMethod("dump", java.nio.file.Path.class).invoke(this.jfrRecording, out);
+                recCls.getMethod("close").invoke(this.jfrRecording);
+                this.jfrRecording = null;
+                return "Profiling stopped. Duration=" + this.lastDurationMillis + " ms. JFR saved to " + out.toString();
+            } catch (Throwable ignored) {
+                this.jfrRecording = null;
+                return "Profiling stopped. Duration=" + this.lastDurationMillis + " ms. (JFR dump failed)";
+            }
+        }
+        return "Profiling stopped. Duration=" + this.lastDurationMillis + " ms.";
+    }
+
+    public boolean isRunning() { return this.running; }
+    public long elapsedMillis() { return this.running ? (System.currentTimeMillis() - this.startMillis) : this.lastDurationMillis; }
+}
