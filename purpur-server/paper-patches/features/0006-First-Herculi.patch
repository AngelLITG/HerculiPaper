@@ -0,0 +1,37 @@
+package org.bukkit.craftbukkit.util.threading;
+
+import io.multipaper.herculi.Herculi;
+import net.minecraft.core.BlockPos;
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.level.Level;
+import java.util.Objects;
+import java.util.concurrent.CompletableFuture;
+import java.util.function.Consumer;
+
+/**
+ * Craft-layer helpers to marshal work through Herculi's thread-affine
+ * no-op shims. These are intentionally thin wrappers so Craft code can
+ * reference them without pulling herculi helpers into NMS.
+ */
+public final class HerculiSync {
+    private HerculiSync() {}
+
+    public static void ensureSync(Entity entity, Runnable task) {
+        Objects.requireNonNull(task, "task");
+        Herculi.ensureSync(entity, task);
+    }
+
+    public static void ensureSync(Entity entity, Consumer<Entity> consumer) {
+        Objects.requireNonNull(consumer, "consumer");
+        Herculi.ensureSync(entity, consumer);
+    }
+
+    public static void ensureSync(Level level, BlockPos pos, Runnable task) {
+        Objects.requireNonNull(task, "task");
+        Herculi.ensureSync(level, pos, task);
+    }
+
+    public static <T> CompletableFuture<T> runSync(Level level, BlockPos pos, CompletableFuture<T> future) {
+        return Herculi.runSync(level, pos, future);
+    }
+}
