@@ -0,0 +1,81 @@
+package io.multipaper.herculi.fairness;
+
+import java.util.concurrent.atomic.AtomicLong;
+
+/**
+ * Fairness budgets and counters (default-off).
+ * Categories are soft budgets per tick; wrappers may be used by callers to cap work.
+ */
+public final class Fairness {
+    private Fairness() {}
+
+    public enum Category { BROADCAST_DRAIN, DIAGNOSTICS_DRAIN, ASYNC_COMPLETIONS }
+
+    // Budgets (units depend on category; for drains, units are "batches" or "items")
+    private static volatile boolean enabled;
+    private static volatile int budgetBroadcastDrain;
+    private static volatile int budgetDiagnosticsDrain;
+    private static volatile int budgetAsyncCompletions;
+
+    // Counters (monotonic)
+    public static final AtomicLong overBudgetBroadcast = new AtomicLong();
+    public static final AtomicLong overBudgetDiagnostics = new AtomicLong();
+    public static final AtomicLong overBudgetAsync = new AtomicLong();
+
+    // Rolling per-tick consumption (reset by caller each tick if used centrally)
+    private static final ThreadLocal<int[]> consumption = ThreadLocal.withInitial(() -> new int[Category.values().length]);
+
+    public static void initFromConfig(io.multipaper.herculi.config.HerculiConfig cfg) {
+        enabled = cfg.fairnessEnabled();
+        budgetBroadcastDrain = Math.max(1, cfg.fairnessBroadcastDrainBudget());
+        budgetDiagnosticsDrain = Math.max(1, cfg.fairnessDiagnosticsDrainBudget());
+        budgetAsyncCompletions = Math.max(1, cfg.fairnessAsyncCompletionsBudget());
+    }
+
+    public static boolean isEnabled() { return enabled; }
+
+    public static int currentBudget(Category c) {
+        return switch (c) {
+            case BROADCAST_DRAIN -> budgetBroadcastDrain;
+            case DIAGNOSTICS_DRAIN -> budgetDiagnosticsDrain;
+            case ASYNC_COMPLETIONS -> budgetAsyncCompletions;
+        };
+    }
+
+    /**
+     * Attempt to consume up to amount units from the category budget. Returns the allowed amount.
+     * If fairness is disabled, returns amount.
+     */
+    public static int tryConsume(Category c, int amount) {
+        if (!enabled || amount <= 0) return amount;
+        int idx = c.ordinal();
+        int[] cons = consumption.get();
+        int used = cons[idx];
+        int budget = currentBudget(c);
+        int remaining = Math.max(0, budget - used);
+        if (remaining <= 0) {
+            incrementOver(c);
+            return 0;
+        }
+        int allowed = Math.min(amount, remaining);
+        cons[idx] = used + allowed;
+        if (allowed < amount) incrementOver(c);
+        return allowed;
+    }
+
+    private static void incrementOver(Category c) {
+        switch (c) {
+            case BROADCAST_DRAIN -> overBudgetBroadcast.incrementAndGet();
+            case DIAGNOSTICS_DRAIN -> overBudgetDiagnostics.incrementAndGet();
+            case ASYNC_COMPLETIONS -> overBudgetAsync.incrementAndGet();
+        }
+    }
+
+    /**
+     * Reset per-tick consumption counters for the current thread. Typically called once per main-tick.
+     */
+    public static void resetTickConsumption() {
+        int[] cons = consumption.get();
+        java.util.Arrays.fill(cons, 0);
+    }
+}
