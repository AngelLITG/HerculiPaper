+package io.multipaper.herculi.spawn;
+
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.world.entity.MobCategory;
+import net.minecraft.world.level.NaturalSpawner;
+import net.minecraft.world.level.chunk.LevelChunk;
+
+/**
+ * Extension point for custom natural spawners.
+ * Implementations must be fast and MUST NOT load chunks synchronously.
+ * Only called when registry is non-empty and config allows (default-off).
+ */
+public interface CustomSpawner {
+    /**
+     * Whether this spawner is enabled. Called on main thread.
+     */
+    default boolean enabled() { return true; }
+
+    /**
+     * Perform custom spawn logic for a given category and chunk. Implementations
+     * should respect mobcaps (via spawnState.canSpawnForCategoryLocal/Global) and avoid chunk loads.
+     */
+    void spawnForChunk(ServerLevel level, LevelChunk chunk, MobCategory category, NaturalSpawner.SpawnState spawnState);
+}
