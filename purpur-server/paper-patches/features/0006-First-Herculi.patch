@@ -0,0 +1,46 @@
+package io.multipaper.herculi.spawn;
+
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.world.entity.MobCategory;
+import net.minecraft.world.level.NaturalSpawner;
+import net.minecraft.world.level.chunk.LevelChunk;
+
+import java.util.Objects;
+import java.util.concurrent.CopyOnWriteArrayList;
+
+/**
+ * Thread-safe registry for CustomSpawner implementations.
+ * Default-off: if the registry is empty, no hooks run and vanilla behavior is unchanged.
+ */
+public final class CustomSpawnerRegistry {
+    private static final CustomSpawnerRegistry INSTANCE = new CustomSpawnerRegistry();
+    public static CustomSpawnerRegistry instance() { return INSTANCE; }
+
+    private final CopyOnWriteArrayList<CustomSpawner> spawners = new CopyOnWriteArrayList<>();
+
+    private CustomSpawnerRegistry() {}
+
+    public void register(CustomSpawner spawner) {
+        Objects.requireNonNull(spawner, "spawner");
+        spawners.addIfAbsent(spawner);
+    }
+
+    public void unregister(CustomSpawner spawner) {
+        if (spawner != null) spawners.remove(spawner);
+    }
+
+    public boolean hasSpawners() { return !spawners.isEmpty(); }
+
+    public void spawnForChunk(ServerLevel level, LevelChunk chunk, MobCategory category, NaturalSpawner.SpawnState spawnState) {
+        if (spawners.isEmpty()) return; // default-off
+        for (CustomSpawner s : spawners) {
+            try {
+                if (s.enabled()) {
+                    s.spawnForChunk(level, chunk, category, spawnState);
+                }
+            } catch (Throwable ignored) {
+                // swallow to ensure custom spawner can't break vanilla pipeline
+            }
+        }
+    }
+}
