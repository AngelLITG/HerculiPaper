+package io.multipaper.herculi.threading;
+
+/**
+ * No-op region lock handle for Phase 1. Real locking will be added later.
+ */
+public final class RegionLock implements AutoCloseable {
+    private static final RegionLock NO_OP = new RegionLock(null);
+    private final Runnable onClose;
+
+    private RegionLock(final Runnable onClose) {
+        this.onClose = onClose;
+    }
+
+    public static RegionLock noop() {
+        return NO_OP;
+    }
+
+    static RegionLock of(final Runnable onClose) {
+        if (onClose == null) return NO_OP;
+        return new RegionLock(onClose);
+    }
+
+    @Override
+    public void close() {
+        if (this.onClose != null) {
+            try { this.onClose.run(); } catch (Throwable ignored) {}
+        }
+    }
+}
