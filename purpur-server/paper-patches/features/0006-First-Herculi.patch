@@ -0,0 +1,225 @@
+package io.multipaper.herculi.threading;
+
+import io.multipaper.herculi.region.RegionKey;
+import io.multipaper.herculi.config.HerculiConfig;
+import java.util.concurrent.locks.StampedLock;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.Map;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.Comparator;
+import java.util.List;
+import java.util.concurrent.atomic.AtomicLong;
+
+/**
+ * Minimal scaffolding for a region locker. This will evolve to handle
+ * per-region read/write locks and neighbor locking semantics. For now,
+ * it exposes a placeholder global lock and no-op acquisition APIs to
+ * allow early integrations to compile without changing behavior.
+ */
+public final class HerculiRegionLocker {
+    private static final HerculiRegionLocker INSTANCE = new HerculiRegionLocker();
+
+    public static HerculiRegionLocker instance() {
+        return INSTANCE;
+    }
+
+    /**
+     * Acquire a neighborhood of read locks around a center region with a square radius.
+     * Locks are acquired in a deterministic order to avoid deadlocks.
+     */
+    public RegionLock acquireReadNeighborhood(final RegionKey center, final int radius) {
+        if (!HerculiConfig.instance().threadingEnabled() || center == null || radius <= 0) {
+            return RegionLock.noop();
+        }
+        final List<RegionKey> keys = new ArrayList<>();
+        for (int dz = -radius; dz <= radius; dz++) {
+            for (int dx = -radius; dx <= radius; dx++) {
+                keys.add(new RegionKey(center.dimension, center.rx + dx, center.rz + dz));
+            }
+        }
+        keys.sort(Comparator
+            .comparingInt((RegionKey k) -> k.rx)
+            .thenComparingInt(k -> k.rz));
+
+        final List<StampedLock> locks = new ArrayList<>(keys.size());
+        final List<Long> stamps = new ArrayList<>(keys.size());
+        boolean success = false;
+        try {
+            for (RegionKey k : keys) {
+                final StampedLock l = regionLocks.computeIfAbsent(k, kk -> new StampedLock());
+                final long s = l.readLock();
+                locks.add(l);
+                stamps.add(s);
+                readAcquired.incrementAndGet();
+            }
+            success = true;
+        } finally {
+            if (!success) {
+                for (int i = stamps.size() - 1; i >= 0; i--) {
+                    try { locks.get(i).unlockRead(stamps.get(i)); } catch (Throwable ignored) {} finally { readReleased.incrementAndGet(); }
+                }
+            }
+        }
+
+        return RegionLock.of(() -> {
+            for (int i = stamps.size() - 1; i >= 0; i--) {
+                try { locks.get(i).unlockRead(stamps.get(i)); } catch (Throwable ignored) {} finally { readReleased.incrementAndGet(); }
+            }
+        });
+    }
+
+    /**
+     * Returns a simple lock stats string for diagnostics.
+     */
+    public String lockStats() {
+        int count = this.regionLocks.size();
+        long rA = readAcquired.get();
+        long rR = readReleased.get();
+        long wA = writeAcquired.get();
+        long wR = writeReleased.get();
+        return "regionLocks=" + count + ", read(acq=" + rA + ", rel=" + rR + "), write(acq=" + wA + ", rel=" + wR + ")";
+    }
+
+    /**
+     * Snapshot DTO for diagnostics.
+     */
+    public static final class LockSnapshot {
+        public final int regionLockCount;
+        public final long readAcquired;
+        public final long readReleased;
+        public final long writeAcquired;
+        public final long writeReleased;
+
+        public LockSnapshot(int regionLockCount, long readAcquired, long readReleased, long writeAcquired, long writeReleased) {
+            this.regionLockCount = regionLockCount;
+            this.readAcquired = readAcquired;
+            this.readReleased = readReleased;
+            this.writeAcquired = writeAcquired;
+            this.writeReleased = writeReleased;
+        }
+    }
+
+    /**
+     * Return a snapshot of lock counters for diagnostics.
+     */
+    public LockSnapshot snapshot() {
+        return new LockSnapshot(
+            this.regionLocks.size(),
+            this.readAcquired.get(),
+            this.readReleased.get(),
+            this.writeAcquired.get(),
+            this.writeReleased.get()
+        );
+    }
+
+    static {
+        // Ensure locks are cleared on JVM shutdown as a fallback
+        try {
+            Runtime.getRuntime().addShutdownHook(new Thread(() -> {
+                try { HerculiRegionLocker.instance().shutdown(); } catch (Throwable ignored) {}
+            }, "Herculi-RegionLocks-Shutdown"));
+        } catch (Throwable ignored) {}
+    }
+
+    // Placeholder global lock; not used yet.
+    private final StampedLock globalLock = new StampedLock();
+    // Minimal per-region lock map; enabled only when threading is enabled.
+    private final Map<RegionKey, StampedLock> regionLocks = new ConcurrentHashMap<>();
+    // Contention/diagnostic counters
+    private final AtomicLong readAcquired = new AtomicLong();
+    private final AtomicLong readReleased = new AtomicLong();
+    private final AtomicLong writeAcquired = new AtomicLong();
+    private final AtomicLong writeReleased = new AtomicLong();
+
+    public StampedLock globalLock() {
+        return this.globalLock;
+    }
+
+    /**
+     * Acquire a read lock for the given region. Phase 1: returns a no-op lock.
+     */
+    public RegionLock acquireRead(final RegionKey key) {
+        if (!HerculiConfig.instance().threadingEnabled() || key == null) {
+            return RegionLock.noop();
+        }
+        final StampedLock lock = regionLocks.computeIfAbsent(key, k -> new StampedLock());
+        final long stamp = lock.readLock();
+        readAcquired.incrementAndGet();
+        return RegionLock.of(() -> {
+            try { lock.unlockRead(stamp); } catch (Throwable ignored) {}
+            readReleased.incrementAndGet();
+        });
+    }
+
+    /**
+     * Acquire a write lock for the given region. Phase 1: returns a no-op lock.
+     */
+    public RegionLock acquireWrite(final RegionKey key) {
+        if (!HerculiConfig.instance().threadingEnabled() || key == null) {
+            return RegionLock.noop();
+        }
+        final StampedLock lock = regionLocks.computeIfAbsent(key, k -> new StampedLock());
+        final long stamp = lock.writeLock();
+        writeAcquired.incrementAndGet();
+        return RegionLock.of(() -> {
+            try { lock.unlockWrite(stamp); } catch (Throwable ignored) {}
+            writeReleased.incrementAndGet();
+        });
+    }
+
+    /**
+     * Acquire a neighborhood of write locks around a center region with a square radius.
+     * Locks are acquired in a deterministic order to avoid deadlocks.
+     */
+    public RegionLock acquireWriteNeighborhood(final RegionKey center, final int radius) {
+        if (!HerculiConfig.instance().threadingEnabled() || center == null || radius <= 0) {
+            return RegionLock.noop();
+        }
+        // Build sorted list of neighbor keys
+        final List<RegionKey> keys = new ArrayList<>();
+        for (int dz = -radius; dz <= radius; dz++) {
+            for (int dx = -radius; dx <= radius; dx++) {
+                keys.add(new RegionKey(center.dimension, center.rx + dx, center.rz + dz));
+            }
+        }
+        keys.sort(Comparator
+            .comparingInt((RegionKey k) -> k.rx)
+            .thenComparingInt(k -> k.rz));
+
+        // Acquire all write locks in order, track stamps, and release on close in reverse order
+        final List<StampedLock> locks = new ArrayList<>(keys.size());
+        final List<Long> stamps = new ArrayList<>(keys.size());
+        boolean success = false;
+        try {
+            for (RegionKey k : keys) {
+                final StampedLock l = regionLocks.computeIfAbsent(k, kk -> new StampedLock());
+                final long s = l.writeLock();
+                locks.add(l);
+                stamps.add(s);
+                writeAcquired.incrementAndGet();
+            }
+            success = true;
+        } finally {
+            if (!success) {
+                // best-effort partial unlock if acquisition failed mid-way
+                for (int i = stamps.size() - 1; i >= 0; i--) {
+                    try { locks.get(i).unlockWrite(stamps.get(i)); } catch (Throwable ignored) {} finally { writeReleased.incrementAndGet(); }
+                }
+            }
+        }
+
+        return RegionLock.of(() -> {
+            for (int i = stamps.size() - 1; i >= 0; i--) {
+                try { locks.get(i).unlockWrite(stamps.get(i)); } catch (Throwable ignored) {} finally { writeReleased.incrementAndGet(); }
+            }
+        });
+    }
+
+    /**
+     * Clear all region locks (used on shutdown).
+     */
+    public void shutdown() {
+        regionLocks.clear();
+    }
+}
