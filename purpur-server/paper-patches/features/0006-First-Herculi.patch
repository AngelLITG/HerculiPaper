+package io.multipaper.herculi.threading;
+
+import io.multipaper.herculi.config.HerculiConfig;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.world.level.ChunkPos;
+import net.minecraft.world.level.chunk.LevelChunk;
+
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.atomic.AtomicLong;
+
+/**
+ * Tiny read-only precompute for random tick candidate positions.
+ * Default-off, scheduled on the region executor. Results are intentionally discarded
+ * for Phase 0, this only exercises scheduling/cpu without touching game logic.
+ */
+public final class LevelRandomPrecompute {
+    private static final AtomicLong scheduled = new AtomicLong();
+    private static final AtomicLong completed = new AtomicLong();
+    // Tiny cache: chunkKey -> packed candidate triples (rx,ry,rz) repeated; intentionally small and ephemeral
+    private static final ConcurrentHashMap<Long, int[]> cache = new ConcurrentHashMap<>();
+
+    private LevelRandomPrecompute() {}
+
+    public static void schedule(ServerLevel level, LevelChunk chunk, int tickSpeed) {
+        if (level == null || chunk == null) return;
+        if (!HerculiConfig.instance().threadingEnabled()) return;
+        final ChunkPos cpos = chunk.getPos();
+        final int bx = cpos.getMinBlockX();
+        final int bz = cpos.getMinBlockZ();
+        scheduled.incrementAndGet();
+        WorldRegionScheduler.execute(level, bx, bz, () -> {
+            try {
+                // Read-only pseudo-work: derive some positions without touching the world
+                final long seed = ((long)cpos.x * 341873128712L) ^ ((long)cpos.z * 132897987541L) ^ level.getGameTime();
+                long s = seed ^ 0x9E3779B97F4A7C15L;
+                int n = Math.max(1, Math.min(8, tickSpeed));
+                int acc = 0;
+                int[] out = new int[n * 3];
+                for (int i = 0; i < n; i++) {
+                    s ^= (s >>> 30) * 0xBF58476D1CE4E5B9L;
+                    s ^= (s >>> 27) * 0x94D049BB133111EBL;
+                    s ^= (s >>> 31);
+                    int rx = (int)(s & 15L);
+                    int rz = (int)((s >>> 4) & 15L);
+                    int ry = (int)((s >>> 8) & 15L); // section-local; unused
+                    acc ^= (rx << 8) ^ (ry << 4) ^ rz; // prevent JIT dead-code elision
+                    int base = i * 3;
+                    out[base] = rx; out[base + 1] = ry; out[base + 2] = rz;
+                }
+                if (acc == 0x7F7F) {
+                    // impossible guard; no-op
+                }
+                // publish to cache (overwrite is fine)
+                final long key = (((long)cpos.x) << 32) ^ (cpos.z & 0xFFFFFFFFL);
+                cache.put(key, out);
+            } finally {
+                completed.incrementAndGet();
+            }
+        });
+    }
+
+    /**
+     * Retrieve and discard the latest precomputed positions for the given chunk.
+     * Returns null if none available. Main-thread consumption only.
+     */
+    public static int[] poll(ServerLevel level, LevelChunk chunk) {
+        if (level == null || chunk == null) return null;
+        final ChunkPos cpos = chunk.getPos();
+        final long key = (((long)cpos.x) << 32) ^ (cpos.z & 0xFFFFFFFFL);
+        return cache.remove(key);
+    }
+
+    public static long getScheduled() { return scheduled.get(); }
+    public static long getCompleted() { return completed.get(); }
+}
