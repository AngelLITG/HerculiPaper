@@ -0,0 +1,45 @@
+package io.multipaper.herculi.instrumentation;
+
+import java.util.concurrent.atomic.AtomicLong;
+
+public final class HerculiUnloadMetrics {
+    private static final AtomicLong count = new AtomicLong();
+    private static final AtomicLong nanosTotal = new AtomicLong();
+    private static final AtomicLong nanosMax = new AtomicLong();
+
+    private HerculiUnloadMetrics() {}
+
+    public static long start() {
+        return System.nanoTime();
+    }
+
+    public static void end(long startNanoTime) {
+        if (startNanoTime == 0L) return;
+        long dur = System.nanoTime() - startNanoTime;
+        count.incrementAndGet();
+        nanosTotal.addAndGet(dur);
+        // max update loop
+        long prev;
+        while (dur > (prev = nanosMax.get())) {
+            if (nanosMax.compareAndSet(prev, dur)) break;
+        }
+    }
+
+    public static long getCount() { return count.get(); }
+    public static long getTotalNanos() { return nanosTotal.get(); }
+    public static long getMaxNanos() { return nanosMax.get(); }
+
+    public static long getAvgMicros() {
+        long c = count.get();
+        if (c == 0L) return 0L;
+        return (nanosTotal.get() / c) / 1_000L;
+    }
+
+    public static long getMaxMicros() { return nanosMax.get() / 1_000L; }
+
+    public static void reset() {
+        count.set(0L);
+        nanosTotal.set(0L);
+        nanosMax.set(0L);
+    }
+}
