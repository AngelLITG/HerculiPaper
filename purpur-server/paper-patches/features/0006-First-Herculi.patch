@@ -0,0 +1,54 @@
+package io.multipaper.herculi.instrumentation;
+
+import io.multipaper.herculi.threading.RegionSchedulers;
+import io.multipaper.herculi.broadcast.BroadcastMetrics;
+import io.multipaper.herculi.broadcast.BroadcastRegistry;
+
+/**
+ * Queues/back-pressure snapshot scaffolding.
+ * Phase 0: returns basic counters from instrumentation; integrate real queues later.
+ */
+public final class HerculiQueues {
+    private static final HerculiQueues INSTANCE = new HerculiQueues();
+    public static HerculiQueues instance() { return INSTANCE; }
+    private HerculiQueues() {}
+
+    public String snapshot() {
+        HerculiInstrumentation inst = HerculiInstrumentation.instance();
+        long pools = inst.regionPoolsCreated();
+        long enq = inst.regionTasksEnqueued();
+        long exe = inst.regionTasksExecuted();
+        long inFlight = Math.max(0, enq - exe);
+        int active = RegionSchedulers.activeExecutorCount();
+        // Level probes
+        String levelProbe = "";
+        try {
+            long lpSched = LevelParallelProbe.getScheduled();
+            long lpDone = LevelParallelProbe.getCompleted();
+            levelProbe = ", levelProbe.scheduled=" + lpSched + ", levelProbe.completed=" + lpDone
+                + ", precompute.scheduled=" + io.multipaper.herculi.threading.LevelRandomPrecompute.getScheduled()
+                + ", precompute.completed=" + io.multipaper.herculi.threading.LevelRandomPrecompute.getCompleted();
+        } catch (Throwable ignored) {}
+        // Broadcast metrics (if available)
+        String broadcast = "";
+        try {
+            final boolean bcEnabled = BroadcastRegistry.enabled();
+            final int qMgrSize = BroadcastRegistry.manager().size();
+            final int qPending = BroadcastRegistry.manager().pendingSize();
+            final long qActive = BroadcastMetrics.getActiveQueues();
+            final long enqB = BroadcastMetrics.getEnqueuedBatches();
+            final long deqB = BroadcastMetrics.getDequeuedBatches();
+            final long dropOv = BroadcastMetrics.getDroppedBatchesOverflow();
+            final long dropTo = BroadcastMetrics.getDroppedBatchesTimeout();
+            broadcast = ", broadcast.enabled=" + bcEnabled
+                + ", broadcast.managerSize=" + qMgrSize
+                + ", broadcast.pendingBatches=" + qPending
+                + ", broadcast.activeQueues=" + qActive
+                + ", broadcast.enqueuedBatches=" + enqB
+                + ", broadcast.dequeuedBatches=" + deqB
+                + ", broadcast.dropOverflow=" + dropOv
+                + ", broadcast.dropTimeout=" + dropTo;
+        } catch (Throwable ignored) {}
+        return "activeExecutors=" + active + ", poolsCreated=" + pools + ", enqueued=" + enq + ", executed=" + exe + ", inFlight=" + inFlight + levelProbe + broadcast;
+    }
+}
