--- /dev/null
+++ b/src/main/java/io/multipaper/herculi/api/BukkitThreadGuard.java
@@ -0,0 +1,22 @@
+package io.multipaper.herculi.api;
+
+/**
+ * Lightweight, gated main-thread guard for Bukkit API entrypoints.
+ * Does not throw; only logs when guardrails are enabled.
+ */
+public final class BukkitThreadGuard {
+    private BukkitThreadGuard() {}
+
+    public static void ensureMainThread(String apiName) {
+        try {
+            if (!io.multipaper.herculi.config.HerculiConfig.instance().guardrailsEnabled()) return;
+            final net.minecraft.server.MinecraftServer srv = net.minecraft.server.MinecraftServer.getServer();
+            final boolean onMain = (srv == null) || srv.isSameThread();
+            if (!onMain) {
+                org.bukkit.Bukkit.getLogger().warning("[Herculi] Bukkit API off-main thread: " + (apiName == null ? "unknown" : apiName));
+            }
+        } catch (Throwable ignored) {
+            // Best effort only
+        }
+    }
+}
diff --git a/src/main/java/io/multipaper/herculi/broadcast/BroadcastManager.java b/src/main/java/io/multipaper/herculi/broadcast/BroadcastManager.java
new file mode 100644
index 0000000000000000000000000000000000000000..3e5c899ad4d8ed27b55dda5f6af03a3d5749789f
--- /dev/null
+++ b/src/main/java/io/multipaper/herculi/broadcast/BroadcastManager.java
@@ -0,0 +1,118 @@
+package io.multipaper.herculi.broadcast;
+
+import io.multipaper.herculi.config.HerculiConfig;
+import net.minecraft.network.Connection;
+import net.minecraft.network.protocol.Packet;
+import net.minecraft.network.protocol.game.ClientboundSectionBlocksUpdatePacket;
+import net.minecraft.server.level.ServerPlayer;
+
+import java.util.Map;
+import java.lang.ref.WeakReference;
+import java.util.Objects;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.ConcurrentLinkedQueue;
+import java.util.concurrent.atomic.AtomicLong;
+
+/**
+ * Minimal, gated broadcasting manager inspired by ShreddedPaper 0028.
+ *
+ * Current behavior when enabled:
+ * - Coalesce and queue section block update packets per-recipient.
+ * - Perform a small immediate drain with a budget to reduce packet spam.
+ *
+ * This keeps everything on the main thread for now (no thread creation), but
+ * establishes an architecture for future threaded/budgeted drains.
+ */
+public final class BroadcastManager {
+    private static final BroadcastManager INSTANCE = new BroadcastManager();
+
+    public static BroadcastManager instance() { return INSTANCE; }
+
+    private final Map<Connection, ConcurrentLinkedQueue<Packet<?>>> perRecipientQueues = new ConcurrentHashMap<>();
+    private final Map<Connection, WeakReference<ServerPlayer>> recipients = new ConcurrentHashMap<>();
+    private final AtomicLong enqueued = new AtomicLong();
+    private final AtomicLong drained = new AtomicLong();
+
+    private BroadcastManager() {}
+
+    public boolean enabled() {
+        return HerculiConfig.instance().getBoolean("broadcasting.threaded.enabled", false);
+    }
+
+    private int drainBudgetPerEnqueue() {
+        // reuse maxBatchesPerQueue as a small per-enqueue drain budget if present
+        return Math.max(1, HerculiConfig.instance().getInt("broadcasting.threaded.maxBatchesPerQueue", 16));
+    }
+
+    public void sendOrEnqueue(final ServerPlayer player, final Packet<?> packet, final String tag) {
+        if (!enabled()) {
+            player.connection.send(packet);
+            return;
+        }
+        // Only queue section block updates for now; pass-through others
+        if (!(packet instanceof ClientboundSectionBlocksUpdatePacket)) {
+            player.connection.send(packet);
+            return;
+        }
+        final Connection key = player.connection.connection;
+        final ConcurrentLinkedQueue<Packet<?>> q = perRecipientQueues.computeIfAbsent(key, k -> new ConcurrentLinkedQueue<>());
+        recipients.put(key, new WeakReference<>(player));
+        q.add(packet);
+        enqueued.incrementAndGet();
+        // Small immediate drain on the same thread (assumed main) to cap growth
+        int budget = drainBudgetPerEnqueue();
+        Packet<?> p;
+        while (budget-- > 0 && (p = q.poll()) != null) {
+            player.connection.send(p);
+            drained.incrementAndGet();
+        }
+        // If queue still has items, it will be drained by subsequent enqueues; a periodic ticker can be added later.
+    }
+
+    public void drainFor(final ServerPlayer player, final int budget) {
+        if (!enabled()) return;
+        final Connection key = player.connection.connection;
+        final ConcurrentLinkedQueue<Packet<?>> q = perRecipientQueues.get(key);
+        if (q == null || q.isEmpty()) return;
+        int b = Math.max(1, budget);
+        Packet<?> p;
+        while (b-- > 0 && (p = q.poll()) != null) {
+            player.connection.send(p);
+            drained.incrementAndGet();
+        }
+        if (q.isEmpty()) perRecipientQueues.remove(key, q);
+    }
+
+    public int drainAll(int maxPerRecipient) {
+        if (!enabled()) return 0;
+        int sent = 0;
+        for (Map.Entry<Connection, ConcurrentLinkedQueue<Packet<?>>> e : perRecipientQueues.entrySet()) {
+            final Connection key = e.getKey();
+            final ConcurrentLinkedQueue<Packet<?>> q = e.getValue();
+            final WeakReference<ServerPlayer> ref = recipients.get(key);
+            final ServerPlayer player = ref != null ? ref.get() : null;
+            if (player == null || player.connection == null) {
+                // drop queue if player is gone
+                perRecipientQueues.remove(key);
+                recipients.remove(key);
+                continue;
+            }
+            int budget = Math.max(1, maxPerRecipient);
+            Packet<?> p;
+            while (budget-- > 0 && (p = q.poll()) != null) {
+                player.connection.send(p);
+                sent++;
+                drained.incrementAndGet();
+            }
+            if (q.isEmpty()) {
+                perRecipientQueues.remove(key, q);
+                recipients.remove(key);
+            }
+        }
+        return sent;
+    }
+
+    public long getEnqueued() { return enqueued.get(); }
+    public long getDrained() { return drained.get(); }
+    public int getApproxQueueCount() { return perRecipientQueues.size(); }
+}
