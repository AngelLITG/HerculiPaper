+package org.bukkit.craftbukkit.command;
+
+import org.bukkit.command.Command;
+import org.bukkit.command.CommandSender;
+import org.jetbrains.annotations.NotNull;
+import io.multipaper.herculi.threading.HerculiRegionLocker;
+import io.multipaper.herculi.instrumentation.HerculiInstrumentation;
+
+public final class HerculiCommand extends org.bukkit.command.defaults.BukkitCommand {
+
+    public HerculiCommand() {
+        super("herculi");
+        this.setDescription("Herculi diagnostics and profiling commands");
+        this.setUsage("/herculi <profile|locks|queues|reload> [args]");
+        this.setPermission("herculi.command");
+    }
+
+    @Override
+    public boolean execute(@NotNull CommandSender sender, @NotNull String label, @NotNull String[] args) {
+        if (!this.testPermission(sender)) return true;
+        if (args.length == 0) {
+            sender.sendMessage("Usage: " + this.getUsage());
+            return true;
+        }
+        final String sub = args[0].toLowerCase();
+        switch (sub) {
+            case "reload":
+                io.multipaper.herculi.config.HerculiConfig.instance().reload();
+                try {
+                    final io.multipaper.herculi.config.HerculiConfig cfg = io.multipaper.herculi.config.HerculiConfig.instance();
+                    // refresh fairness
+                    io.multipaper.herculi.fairness.Fairness.initFromConfig(cfg);
+                    // refresh broadcast registry budgets
+                    final boolean bcEnabled = cfg.broadcastingThreadedEnabled();
+                    final int maxQueuesTotal = cfg.broadcastingThreadedMaxQueuesTotal();
+                    final int maxBatchesPerQueue = cfg.broadcastingThreadedMaxBatchesPerQueue();
+                    final String dropRaw = cfg.broadcastingThreadedDropPolicyRaw();
+                    io.multipaper.herculi.broadcast.RecipientQueue.DropPolicy dropPolicy;
+                    try {
+                        dropPolicy = io.multipaper.herculi.broadcast.RecipientQueue.DropPolicy.valueOf(dropRaw.trim().toUpperCase(java.util.Locale.ROOT));
+                    } catch (Throwable ignored) {
+                        dropPolicy = io.multipaper.herculi.broadcast.RecipientQueue.DropPolicy.COALESCE;
+                    }
+                    final int drainBudget = cfg.fairnessEnabled() ? cfg.fairnessBroadcastDrainBudget() : cfg.broadcastingThreadedDrainBudget();
+                    io.multipaper.herculi.broadcast.BroadcastRegistry.init(bcEnabled, maxQueuesTotal, maxBatchesPerQueue, dropPolicy, drainBudget);
+                } catch (Throwable ignored) {}
+                sender.sendMessage("[Herculi] Configuration reloaded (fairness/broadcast budgets updated).");
+                return true;
+            case "profile":
+                if (args.length < 2) {
+                    sender.sendMessage("[Herculi] Usage: /herculi profile <start|stop> [jfr]");
+                    return true;
+                }
+                String action = args[1].toLowerCase();
+                switch (action) {
+                    case "start": {
+                        boolean withJfr = args.length >= 3 && args[2].equalsIgnoreCase("jfr");
+                        String msg = io.multipaper.herculi.instrumentation.HerculiProfiler.instance().start(withJfr);
+                        sender.sendMessage("[Herculi] " + msg);
+                        return true;
+                    }
+                    case "stop": {
+                        String msg = io.multipaper.herculi.instrumentation.HerculiProfiler.instance().stop();
+                        sender.sendMessage("[Herculi] " + msg);
+                        return true;
+                    }
+                    default:
+                        sender.sendMessage("[Herculi] Usage: /herculi profile <start|stop> [jfr]");
+                        return true;
+                }
+            case "locks":
+                try {
+                    final String stats = HerculiRegionLocker.instance().lockStats();
+                    final HerculiInstrumentation inst = HerculiInstrumentation.instance();
+                    final long pools = inst.regionPoolsCreated();
+                    final long enq = inst.regionTasksEnqueued();
+                    final long exe = inst.regionTasksExecuted();
+                    sender.sendMessage("[Herculi] Locks: " + stats
+                        + "; executors: poolsCreated=" + pools
+                        + ", enqueued=" + enq
+                        + ", executed=" + exe);
+                } catch (Throwable t) {
+                    sender.sendMessage("[Herculi] Locks diagnostics unavailable: " + t.getClass().getSimpleName());
+                }
+                return true;
+            case "queues":
+                try {
+                    String snapshot = io.multipaper.herculi.instrumentation.HerculiQueues.instance().snapshot();
+                    sender.sendMessage("[Herculi] Queues: " + snapshot);
+                } catch (Throwable t) {
+                    sender.sendMessage("[Herculi] Queues snapshot unavailable: " + t.getClass().getSimpleName());
+                }
+                return true;
+            case "probe":
+                try {
+                    if (args.length >= 2 && args[1].equalsIgnoreCase("reset")) {
+                        // best-effort reset by reflecting into AtomicLongs if available; otherwise no-op
+                        try {
+                            java.lang.reflect.Field f1 = io.multipaper.herculi.instrumentation.LevelParallelProbe.class.getDeclaredField("scheduled");
+                            java.lang.reflect.Field f2 = io.multipaper.herculi.instrumentation.LevelParallelProbe.class.getDeclaredField("completed");
+                            f1.setAccessible(true); f2.setAccessible(true);
+                            java.util.concurrent.atomic.AtomicLong a1 = (java.util.concurrent.atomic.AtomicLong) f1.get(null);
+                            java.util.concurrent.atomic.AtomicLong a2 = (java.util.concurrent.atomic.AtomicLong) f2.get(null);
+                            a1.set(0L); a2.set(0L);
+                        } catch (Throwable ignored) {}
+                        try {
+                            java.lang.reflect.Field f3 = io.multipaper.herculi.threading.LevelRandomPrecompute.class.getDeclaredField("scheduled");
+                            java.lang.reflect.Field f4 = io.multipaper.herculi.threading.LevelRandomPrecompute.class.getDeclaredField("completed");
+                            f3.setAccessible(true); f4.setAccessible(true);
+                            java.util.concurrent.atomic.AtomicLong a3 = (java.util.concurrent.atomic.AtomicLong) f3.get(null);
+                            java.util.concurrent.atomic.AtomicLong a4 = (java.util.concurrent.atomic.AtomicLong) f4.get(null);
+                            a3.set(0L); a4.set(0L);
+                        } catch (Throwable ignored) {}
+                        try {
+                            io.multipaper.herculi.instrumentation.HerculiUnloadMetrics.reset();
+                        } catch (Throwable ignored) {}
+                        try {
+                            io.multipaper.herculi.instrumentation.HerculiBlockEntityMetrics.reset();
+                        } catch (Throwable ignored) {}
+                        try {
+                            // no reset API for broadcasting; clear by toggling gate if needed
+                        } catch (Throwable ignored) {}
+                        sender.sendMessage("[Herculi] Probe counters reset.");
+                        return true;
+                    }
+                    long lpSched = io.multipaper.herculi.instrumentation.LevelParallelProbe.getScheduled();
+                    long lpDone = io.multipaper.herculi.instrumentation.LevelParallelProbe.getCompleted();
+                    long pcSched = io.multipaper.herculi.threading.LevelRandomPrecompute.getScheduled();
+                    long pcDone = io.multipaper.herculi.threading.LevelRandomPrecompute.getCompleted();
+                    long uCount = 0, uAvgMicros = 0, uMaxMicros = 0;
+                    long beCount = 0, beAvgMicros = 0, beMaxMicros = 0;
+                    long bEnq = 0, bDrained = 0; int bQueues = 0;
+                    long cpHits = 0, cpBuilds = 0;
+                    long trackCapHits = 0;
+                    try {
+                        uCount = io.multipaper.herculi.instrumentation.HerculiUnloadMetrics.getCount();
+                        uAvgMicros = io.multipaper.herculi.instrumentation.HerculiUnloadMetrics.getAvgMicros();
+                        uMaxMicros = io.multipaper.herculi.instrumentation.HerculiUnloadMetrics.getMaxMicros();
+                    } catch (Throwable ignored) {}
+                    try {
+                        beCount = io.multipaper.herculi.instrumentation.HerculiBlockEntityMetrics.getCount();
+                        beAvgMicros = io.multipaper.herculi.instrumentation.HerculiBlockEntityMetrics.getAvgMicros();
+                        beMaxMicros = io.multipaper.herculi.instrumentation.HerculiBlockEntityMetrics.getMaxMicros();
+                    } catch (Throwable ignored) {}
+                    try {
+                        bEnq = io.multipaper.herculi.broadcast.BroadcastManager.instance().getEnqueued();
+                        bDrained = io.multipaper.herculi.broadcast.BroadcastManager.instance().getDrained();
+                        bQueues = io.multipaper.herculi.broadcast.BroadcastManager.instance().getApproxQueueCount();
+                    } catch (Throwable ignored) {}
+                    try {
+                        cpHits = net.minecraft.server.network.PlayerChunkSender.herculi_getCacheHits();
+                        cpBuilds = net.minecraft.server.network.PlayerChunkSender.herculi_getCacheBuilds();
+                    } catch (Throwable ignored) {}
+                    try {
+                        trackCapHits = io.papermc.paper.FeatureHooks.herculi_getTrackingCapHits();
+                    } catch (Throwable ignored) {}
+                    sender.sendMessage("[Herculi] Probe: levelProbe.scheduled=" + lpSched + ", levelProbe.completed=" + lpDone
+                        + ", precompute.scheduled=" + pcSched + ", precompute.completed=" + pcDone
+                        + ", unloads.count=" + uCount + ", unloads.avg_us=" + uAvgMicros + ", unloads.max_us=" + uMaxMicros
+                        + ", be.count=" + beCount + ", be.avg_us=" + beAvgMicros + ", be.max_us=" + beMaxMicros
+                        + ", bq.enqueued=" + bEnq + ", bq.drained=" + bDrained + ", bq.queues=" + bQueues
+                        + ", cp.cache_hits=" + cpHits + ", cp.cache_builds=" + cpBuilds
+                        + ", tracking.cap_hits=" + trackCapHits);
+                } catch (Throwable t) {
+                    sender.sendMessage("[Herculi] Probe unavailable: " + t.getClass().getSimpleName());
+                }
+                return true;
+            default:
+                sender.sendMessage("Unknown subcommand. " + this.getUsage());
+                return true;
+        }
+    }
+
+    @Override
+    public java.util.List<String> tabComplete(@NotNull CommandSender sender, @NotNull String alias, @NotNull String[] args) {
+        java.util.List<String> out = new java.util.ArrayList<>();
+        if (args.length == 1) {
+            java.util.List<String> roots = java.util.Arrays.asList("profile", "locks", "queues", "probe", "reload");
+            String p = args[0].toLowerCase();
+            for (String r : roots) if (r.startsWith(p)) out.add(r);
+            return out;
+        }
+        if (args.length == 2 && args[0].equalsIgnoreCase("probe")) {
+            java.util.List<String> opts = java.util.Arrays.asList("reset");
+            String p = args[1].toLowerCase();
+            for (String r : opts) if (r.startsWith(p)) out.add(r);
+            return out;
+        }
+        if (args.length == 2 && args[0].equalsIgnoreCase("profile")) {
+            java.util.List<String> opts = java.util.Arrays.asList("start", "stop");
+            String p = args[1].toLowerCase();
+            for (String r : opts) if (r.startsWith(p)) out.add(r);
+            return out;
+        }
+        if (args.length == 3 && args[0].equalsIgnoreCase("profile") && args[1].equalsIgnoreCase("start")) {
+            java.util.List<String> opts = java.util.Arrays.asList("jfr");
+            String p = args[2].toLowerCase();
+            for (String r : opts) if (r.startsWith(p)) out.add(r);
+            return out;
+        }
+        return out;
+    }
+}
