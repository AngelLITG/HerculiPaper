@@ -0,0 +1,121 @@
+package io.multipaper.herculi.threading;
+
+import io.multipaper.herculi.config.HerculiConfig;
+import io.multipaper.herculi.instrumentation.HerculiInstrumentation;
+import org.bukkit.Bukkit;
+import org.bukkit.Location;
+import org.bukkit.entity.Player;
+
+import java.util.Map;
+import java.util.Objects;
+import java.util.concurrent.*;
+
+/**
+ * Phase 2 stub: region executors.
+ * - Computes a region key from player location using HerculiConfig.threadingRegionShift().
+ * - Provides a single-threaded executor per region key.
+ * - For now, region tasks immediately bounce to main thread for Bukkit safety by default.
+ */
+public final class RegionSchedulers {
+    private static final class Holder {
+        final ExecutorService executor;
+        volatile long lastUsedMillis;
+        Holder(ExecutorService ex, long ts) { this.executor = ex; this.lastUsedMillis = ts; }
+    }
+
+    private static final ConcurrentMap<Long, Holder> EXECUTORS = new ConcurrentHashMap<>();
+    private static final HerculiInstrumentation INST = HerculiInstrumentation.instance();
+    private static final java.util.concurrent.atomic.AtomicLong ENQUEUE_COUNT = new java.util.concurrent.atomic.AtomicLong();
+
+    private RegionSchedulers() {}
+
+    public static long regionKeyFor(Location loc) {
+        if (loc == null) return 0L;
+        final int shift = HerculiConfig.instance().threadingRegionShift();
+        final int rx = floorDiv(loc.getBlockX(), 1 << shift);
+        final int rz = floorDiv(loc.getBlockZ(), 1 << shift);
+        return (((long) rx) << 32) ^ (rz & 0xffffffffL);
+    }
+
+    private static int floorDiv(int x, int y) {
+        int r = x / y;
+        // floor division for negatives
+        if ((x ^ y) < 0 && (r * y != x)) r--;
+        return r;
+    }
+
+    private static ExecutorService executorFor(long regionKey) {
+        Holder h = EXECUTORS.computeIfAbsent(regionKey, k -> {
+            ThreadFactory tf = r -> {
+                Thread t = new Thread(r);
+                t.setName("Herculi-RegionExecutor-" + k);
+                t.setDaemon(true);
+                return t;
+            };
+            ExecutorService ex = Executors.newSingleThreadExecutor(tf);
+            INST.incRegionPoolCreated();
+            return new Holder(ex, System.currentTimeMillis());
+        });
+        return h.executor;
+    }
+
+    /**
+     * Execute a task for a player's region. If player is null, runs immediately on the caller thread.
+     */
+    public static void executeFor(Player player, Runnable task) {
+        Objects.requireNonNull(task, "task");
+        if (player == null) {
+            task.run();
+            return;
+        }
+        final long key = regionKeyFor(player.getLocation());
+        // metrics + cleanup sampling
+        INST.incRegionTasksEnqueued();
+        long enq = ENQUEUE_COUNT.incrementAndGet();
+        if (enq % Math.max(1, HerculiConfig.instance().threadingRegionExecutorCleanupEveryEnqueues()) == 0) {
+            sweepIdleExecutors();
+        }
+        Holder holder = EXECUTORS.get(key);
+        if (holder != null) holder.lastUsedMillis = System.currentTimeMillis();
+        executorFor(key).execute(() -> {
+            try {
+                task.run();
+            } finally {
+                INST.incRegionTasksExecuted();
+                Holder h = EXECUTORS.get(key);
+                if (h != null) h.lastUsedMillis = System.currentTimeMillis();
+            }
+        });
+    }
+
+    /**
+     * Execute a task for a player's region, then bounce to the Bukkit main thread for safety.
+     */
+    public static void executeForThenMain(Player player, Runnable task) {
+        Objects.requireNonNull(task, "task");
+        executeFor(player, () -> {
+            if (Bukkit.isPrimaryThread()) {
+                task.run();
+            } else {
+                Bukkit.getScheduler().runTask(Bukkit.getPluginManager().getPlugins()[0], task);
+            }
+        });
+    }
+
+    private static void sweepIdleExecutors() {
+        final long idleMillis = TimeUnit.MINUTES.toMillis(HerculiConfig.instance().threadingRegionExecutorIdleMinutes());
+        final long now = System.currentTimeMillis();
+        for (Map.Entry<Long, Holder> e : EXECUTORS.entrySet()) {
+            Holder h = e.getValue();
+            if (now - h.lastUsedMillis > idleMillis) {
+                if (EXECUTORS.remove(e.getKey(), h)) {
+                    try { h.executor.shutdown(); } catch (Throwable ignored) {}
+                }
+            }
+        }
+    }
+
+    public static int activeExecutorCount() {
+        return EXECUTORS.size();
+    }
+}
