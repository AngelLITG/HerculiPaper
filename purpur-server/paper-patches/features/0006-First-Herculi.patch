+package io.multipaper.herculi.threading;
+
+import io.multipaper.herculi.config.HerculiConfig;
+import io.multipaper.herculi.region.RegionKey;
+import io.multipaper.herculi.region.RegionPos;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.level.ChunkPos;
+
+import java.util.Objects;
+import java.util.concurrent.CompletableFuture;
+
+/**
+ * Minimal scaffold for entity-affine scheduling. Default-off and no-op when disabled.
+ */
+public final class EntityRegionScheduler {
+
+    private EntityRegionScheduler() {}
+
+    public static void execute(final Entity entity, final Runnable task) {
+        Objects.requireNonNull(task, "task");
+        if (entity == null) { task.run(); return; }
+        if (!HerculiConfig.instance().threadingEnabled()) { task.run(); return; }
+        final ServerLevel level = (ServerLevel) entity.level();
+        final ChunkPos pos = new ChunkPos(entity.chunkPosition().x, entity.chunkPosition().z);
+        final RegionKey key = RegionKey.of(level.dimension(), RegionPos.forChunk(pos));
+        final RegionExecutor exec = HerculiRegionExecutors.executorFor(key);
+        exec.execute(task);
+    }
+
+    public static <T> CompletableFuture<T> supply(final Entity entity, final java.util.function.Supplier<T> supplier) {
+        Objects.requireNonNull(supplier, "supplier");
+        if (entity == null || !HerculiConfig.instance().threadingEnabled()) {
+            return CompletableFuture.completedFuture(supplier.get());
+        }
+        final CompletableFuture<T> cf = new CompletableFuture<>();
+        execute(entity, () -> {
+            try { cf.complete(supplier.get()); } catch (Throwable t) { cf.completeExceptionally(t); }
+        });
+        return cf;
+    }
+}
