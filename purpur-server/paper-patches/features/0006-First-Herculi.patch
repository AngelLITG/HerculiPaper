@@ -0,0 +1,62 @@
+package io.multipaper.herculi.util;
+
+import net.minecraft.server.MinecraftServer;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.atomic.AtomicReference;
+
+/**
+ * Guardrails for ensuring work executes on the main thread when required
+ * (e.g., firing Bukkit events). This class provides minimal utilities
+ * without requiring a Plugin instance.
+ */
+public final class MainThread {
+    private MainThread() {}
+
+    /**
+     * @return true if current thread is the server main thread
+     */
+    public static boolean isMainThread() {
+        final MinecraftServer srv = MinecraftServer.getServer();
+        return srv != null && srv.isSameThread();
+    }
+
+    /**
+     * Execute runnable immediately if current thread is main thread, otherwise schedule on main.
+     */
+    public static void ensure(final Runnable runnable) {
+        if (runnable == null) return;
+        final MinecraftServer srv = MinecraftServer.getServer();
+        if (srv == null) { runnable.run(); return; }
+        if (srv.isSameThread()) {
+            runnable.run();
+        } else {
+            srv.execute(runnable);
+        }
+    }
+
+    /**
+     * Run on main thread and wait for completion. If already on main, runs inline.
+     */
+    public static void runOnMainAndWait(final Runnable runnable) {
+        if (runnable == null) return;
+        final MinecraftServer srv = MinecraftServer.getServer();
+        if (srv == null || srv.isSameThread()) { runnable.run(); return; }
+        final CountDownLatch latch = new CountDownLatch(1);
+        srv.execute(() -> { try { runnable.run(); } finally { latch.countDown(); } });
+        try { latch.await(); } catch (InterruptedException ie) { Thread.currentThread().interrupt(); }
+    }
+
+    /**
+     * Supply a value from main thread and wait for the result. If already on main, calls inline.
+     */
+    public static <T> T supplyOnMainAndWait(final java.util.function.Supplier<T> supplier) {
+        if (supplier == null) return null;
+        final MinecraftServer srv = MinecraftServer.getServer();
+        if (srv == null || srv.isSameThread()) { return supplier.get(); }
+        final AtomicReference<T> ref = new AtomicReference<>();
+        final CountDownLatch latch = new CountDownLatch(1);
+        srv.execute(() -> { try { ref.set(supplier.get()); } finally { latch.countDown(); } });
+        try { latch.await(); } catch (InterruptedException ie) { Thread.currentThread().interrupt(); }
+        return ref.get();
+    }
+}
