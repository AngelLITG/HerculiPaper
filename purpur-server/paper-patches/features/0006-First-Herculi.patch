index 0000000000000000000000000000000000000000..d77af9b535186cace5a65d187983e4b8e9f0dccf
--- /dev/null
+++ b/src/main/java/io/multipaper/herculi/Herculi.java
@@ -0,0 +1,51 @@
+package io.multipaper.herculi;
+
+import net.minecraft.world.entity.Entity;
+import net.minecraft.core.BlockPos;
+import net.minecraft.world.level.Level;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.world.level.ChunkPos;
+import java.util.Objects;
+import java.util.concurrent.CompletableFuture;
+import java.util.function.Consumer;
+
+/**
+ * Temporary helper shims to allow early call sites to compile.
+ * These are NO-OP placeholders and will be replaced with proper
+ * region-aware execution in later phases.
+ */
+public final class Herculi {
+
+    private Herculi() {}
+
+    public static void ensureSync(Entity entity, Runnable task) {
+        Objects.requireNonNull(task, "task").run();
+    }
+
+    public static void ensureSync(Entity entity, Consumer<Entity> consumer) {
+        Objects.requireNonNull(consumer, "consumer").accept(entity);
+    }
+
+    public static void ensureSync(Level level, BlockPos pos, Runnable task) {
+        Objects.requireNonNull(task, "task").run();
+    }
+
+    public static <T> CompletableFuture<T> runSync(Level level, BlockPos pos, CompletableFuture<T> future) {
+        return future; // pass-through for now
+    }
+
+    /**
+     * Optional prefetch hook for chunk I/O. Safe no-op when disabled. Intended to be called from
+     * early, low-risk anchors (e.g., ticketing) to warm up chunk data without impacting behavior.
+     */
+    public static void maybePrefetchChunk(final ServerLevel level, final ChunkPos pos) {
+        if (level == null || pos == null) return;
+        if (!io.multipaper.herculi.config.HerculiConfig.instance().threadingEnabled()) return;
+        if (!io.multipaper.herculi.config.HerculiConfig.instance().chunkIoEnabled()) return;
+        try {
+            io.multipaper.herculi.chunk.HerculiChunkPipeline.instance().prefetchChunk(level, pos);
+        } catch (Throwable ignored) {
+            // keep call sites resilient; prefetch is best-effort only
+        }
+    }
+}
diff --git a/src/main/java/io/multipaper/herculi/api/BukkitThreadGuard.java b/src/main/java/io/multipaper/herculi/api/BukkitThreadGuard.java
new file mode 100644
