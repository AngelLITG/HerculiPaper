+package io.multipaper.herculi.config;
+
+/**
+ * Phase 1 scaffolding: Configuration & feature gates placeholder.
+ * In later phases, this will read settings (e.g., herculi.yml) and
+ * expose toggles for multithreading, networking, portal routing, etc.
+ */
+public final class HerculiConfig {
+    private static final HerculiConfig INSTANCE = new HerculiConfig();
+
+    public static HerculiConfig instance() {
+        return INSTANCE;
+    }
+
+    private final java.util.concurrent.ConcurrentHashMap<String, String> values = new java.util.concurrent.ConcurrentHashMap<>();
+    private volatile boolean loaded;
+
+    private HerculiConfig() {}
+
+    // Public API
+    // Multithreaded server: always true
+    public boolean threadingEnabled() { return true; }
+    public boolean handoffEnabled() { return getBoolean("threading.handoff.enabled", false); }
+    public boolean handoffSoundsEnabled() { return getBoolean("threading.handoff.sounds", false); }
+    public boolean handoffParticlesEnabled() { return getBoolean("threading.handoff.particles", false); }
+    public boolean handoffTrackerPacketsEnabled() { return getBoolean("threading.handoff.tracker_packets", false); }
+    public boolean handoffDebugEnabled() { return getBoolean("threading.handoff.debug", false); }
+    // Guardrails & teleport enforcement gates (default ON)
+    public boolean guardrailsEnabled() { return getBoolean("guardrails.enabled", true); }
+    public boolean teleportEnforceMainThread() { return getBoolean("teleport.enforce_main_thread", true); }
+    public boolean networkingParallelFlushEnabled() { return getBoolean("networking.parallel_flush_enabled", false); }
+    public boolean networkFencingEnabled() { return getBoolean("networking.fencing.enabled", false); }
+    public boolean networkFencingDebug() { return getBoolean("networking.fencing.debug", false); }
+    public boolean portalRoutingEnabled() { return getBoolean("portals.routing_enabled", false); }
+    public boolean profilingEnabled() { return getBoolean("profiling.enabled", false); }
+    public boolean marshalPerTarget() { return getBoolean("commands.marshalPerTarget", false); }
+    public boolean marshalDebug() { return getBoolean("commands.marshalDebug", false); }
+    // Level random precompute (default-off)
+    public boolean randomPrecomputeEnabled() { return getBoolean("threading.random_precompute.enabled", false); }
+    // Instrumentation (default-off)
+    public boolean instrumentationUnloadMetricsEnabled() { return getBoolean("instrumentation.unload.metrics_enabled", false); }
+    public boolean instrumentationBlockEntityMetricsEnabled() { return getBoolean("instrumentation.block_entities.metrics_enabled", false); }
+    public int threadingRegionPoolSize() { return Math.max(0, getInt("threading.region_pool_size", 0)); }
+    public int threadingRegionShift() { return Math.max(0, getInt("threading.region_shift", 4)); }
+    public int threadingRegionExecutorIdleMinutes() { return Math.max(1, getInt("threading.region_executor_idle_minutes", 10)); }
+    public int threadingRegionExecutorCleanupEveryEnqueues() { return Math.max(10, getInt("threading.region_executor_cleanup_check_enqueues", 200)); }
+    public boolean chunkIoEnabled() { return getBoolean("threading.chunk_io_enable", false); }
+    public int chunkIoMaxInflight() { return Math.max(1, getInt("threading.chunk_io_max_inflight", 16)); }
+
+    public void reload() {
+        this.loaded = false;
+        this.values.clear();
+        ensureLoaded();
+    }
+
+    // Internal
+    private void ensureLoaded() {
+        if (this.loaded) return;
+        synchronized (this) {
+            if (this.loaded) return;
+            // Load from common locations: ./herculi.yml or ./config/herculi.yml
+            final java.nio.file.Path cwd = java.nio.file.Paths.get("").toAbsolutePath();
+            final java.util.List<java.nio.file.Path> candidates = java.util.List.of(
+                cwd.resolve("herculi.yml"),
+                cwd.resolve("config").resolve("herculi.yml")
+            );
+            boolean found = false;
+            for (java.nio.file.Path path : candidates) {
+                try {
+                    if (java.nio.file.Files.isRegularFile(path)) {
+                        java.util.List<String> lines = java.nio.file.Files.readAllLines(path);
+                        parseKeyValues(lines);
+                        // auto-merge missing defaults into existing file
+                        java.util.Map<String, String> defaults = defaultEntries();
+                        java.util.List<String> toAppend = new java.util.ArrayList<>();
+                        for (java.util.Map.Entry<String, String> e : defaults.entrySet()) {
+                            if (!this.values.containsKey(e.getKey())) {
+                                this.values.put(e.getKey(), e.getValue());
+                                toAppend.add(e.getKey() + ": " + e.getValue());
+                            }
+                        }
+                        if (!toAppend.isEmpty()) {
+                            lines.add("");
+                            lines.add("# Auto-merged missing keys by Herculi");
+                            lines.addAll(toAppend);
+                            try { java.nio.file.Files.write(path, lines); } catch (Throwable ignored) {}
+                        }
+                        found = true;
+                        break; // first found wins
+                    }
+                } catch (Throwable ignored) {
+                    // Ignore parse errors; defaults will apply
+                }
+            }
+            // If not found, write a default scaffold to ./config/herculi.yml
+            if (!found) {
+                try {
+                    final java.nio.file.Path cfgDir = cwd.resolve("config");
+                    final java.nio.file.Path cfgFile = cfgDir.resolve("herculi.yml");
+                    java.nio.file.Files.createDirectories(cfgDir);
+                    if (!java.nio.file.Files.exists(cfgFile)) {
+                        final String scaffold = "# Herculi configuration\n"
+                            + "# Minimal key: value format. Unknown keys are ignored.\n\n"
+                            + "# Threading and regionization\n"
+                            + "threading.enabled: true\n"
+                            + "threading.region_pool_size: 0\n"
+                            + "threading.region_shift: 4\n"
+                            + "threading.region_executor_idle_minutes: 10\n"
+                            + "threading.region_executor_cleanup_check_enqueues: 200\n\n"
+                            + "# Async chunk I/O pipeline\n"
+                            + "threading.chunk_io_enable: false\n"
+                            + "threading.chunk_io_max_inflight: 16\n\n"
+                            + "# Networking options\n"
+                            + "networking.parallel_flush_enabled: false\n"
+                            + "networking.fencing.enabled: false\n"
+                            + "networking.fencing.debug: false\n\n"
+                            + "# Portals/teleportation routing\n"
+                            + "portals.routing_enabled: false\n\n"
+                            + "# Profiling/diagnostics\n"
+                            + "profiling.enabled: false\n\n"
+                            + "# Commands\n"
+                            + "commands.marshalPerTarget: false\n"
+                            + "commands.marshalDebug: false\n\n"
+                            + "# Guardrails (default-on).\n"
+                            + "guardrails.enabled: true\n"
+                            + "teleport.enforce_main_thread: true\n\n"
+                            + "# Handoff (default-off).\n"
+                            + "threading.handoff.enabled: false\n"
+                            + "threading.handoff.sounds: false\n"
+                            + "threading.handoff.particles: false\n"
+                            + "threading.handoff.debug: false\n\n"
+                            + "# Level random tick read-only precompute (default-off)\n"
+                            + "threading.random_precompute.enabled: false\n\n"
+                            + "# Instrumentation toggles (default-off)\n"
+                            + "instrumentation.unload.metrics_enabled: false\n"
+                            + "instrumentation.block_entities.metrics_enabled: false\n"
+                            + "\n# Threaded broadcasting (default-off)\n"
+                            + "broadcasting.threaded.enabled: false\n"
+                            + "broadcasting.threaded.maxBatchesPerQueue: 16\n"
+                            + "broadcasting.threaded.perTickDrainBudget: 4\n"
+                            + "broadcasting.threaded.maxQueuesTotal: 20000\n"
+                            + "broadcasting.threaded.dropPolicy: coalesce\n"
+                            + "broadcasting.threaded.drainIntervalMs: 2\n"
+;
+                            
+                        java.nio.file.Files.writeString(cfgFile, scaffold);
+                    }
+                    // Parse what we just wrote for runtime usage
+                    parseKeyValues(java.nio.file.Files.readAllLines(cfgFile));
+                    // On failure, continue with in-memory defaults
+                } catch (Throwable ignored) {
+                    // failed to write or parse default scaffold; fall back to in-memory defaults
+                }
+            }
+            this.loaded = true;
+        }
+    }
+
+    private void parseKeyValues(java.util.List<String> lines) {
+        for (String raw : lines) {
+            String line = raw.trim();
+            if (line.isEmpty()) continue;
+            if (line.startsWith("#")) continue;
+            int idx = line.indexOf(':');
+            if (idx <= 0) continue;
+            String key = line.substring(0, idx).trim();
+            String val = line.substring(idx + 1).trim();
+            // remove simple quotes if present
+            if ((val.startsWith("\"") && val.endsWith("\"")) || (val.startsWith("'") && val.endsWith("'"))) {
+                val = val.substring(1, val.length() - 1);
+            }
+            if (!key.isEmpty()) {
+                this.values.put(key, val);
+            }
+        }
+    }
+
+    public boolean getBoolean(String key, boolean def) {
+        ensureLoaded();
+        String v = this.values.get(key);
+        if (v == null) return def;
+        v = v.toLowerCase(java.util.Locale.ROOT);
+        if (v.equals("true") || v.equals("yes") || v.equals("on") || v.equals("1")) return true;
+        if (v.equals("false") || v.equals("no") || v.equals("off") || v.equals("0")) return false;
+        return def;
+    }
+
+    public int getInt(String key, int def) {
+        ensureLoaded();
+        String v = this.values.get(key);
+        if (v == null) return def;
+        try {
+            return Integer.parseInt(v.trim());
+        } catch (Throwable ignored) {
+            return def;
+        }
+    }
+
+    public String getString(String key, String def) {
+        ensureLoaded();
+        String v = this.values.get(key);
+        return v == null ? def : v;
+    }
+
+    
+
+    private java.util.Map<String, String> defaultEntries() {
+        java.util.Map<String, String> m = new java.util.LinkedHashMap<>();
+        m.put("threading.enabled", "true");
