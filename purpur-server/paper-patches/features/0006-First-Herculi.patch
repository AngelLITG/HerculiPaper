+package io.multipaper.herculi.threading;
+
+import io.multipaper.herculi.region.RegionKey;
+import io.multipaper.herculi.config.HerculiConfig;
+import io.multipaper.herculi.instrumentation.HerculiInstrumentation;
+import java.util.Map;
+import java.util.Objects;
+import java.util.Queue;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.ConcurrentLinkedQueue;
+import java.util.concurrent.Executor;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.ThreadFactory;
+
+/**
+ * Phase 1 scaffold: returns a region-affine executor.
+ * When threading is disabled (default), returns a direct executor (inline run)
+ * to avoid behavior changes. When enabled via config, provides a per-region
+ * serial executor backed by a shared worker pool.
+ */
+public final class HerculiRegionExecutors {
+
+    private static final RegionExecutor DIRECT = RegionExecutor.DIRECT;
+    private static final Map<RegionKey, RegionExecutor> EXECUTORS = new ConcurrentHashMap<>();
+    private static volatile ExecutorService POOL;
+
+    private HerculiRegionExecutors() {}
+
+    public static RegionExecutor executorFor(final RegionKey key) {
+        Objects.requireNonNull(key, "key");
+        if (!HerculiConfig.instance().threadingEnabled()) {
+            return DIRECT;
+        }
+        ensurePool();
+        return EXECUTORS.computeIfAbsent(key, k -> new SerialRegionExecutor(POOL));
+    }
+
+    private static void ensurePool() {
+        if (POOL != null && !POOL.isShutdown()) return;
+        synchronized (HerculiRegionExecutors.class) {
+            if (POOL != null && !POOL.isShutdown()) return;
+            int configured = HerculiConfig.instance().threadingRegionPoolSize();
+            final int threads = Math.max(2, configured > 0 ? configured : Runtime.getRuntime().availableProcessors());
+            final ThreadFactory tf = r -> {
+                Thread t = new Thread(r, "Herculi-RegionPool");
+                t.setDaemon(true);
+                return t;
+            };
+            POOL = Executors.newFixedThreadPool(threads, tf);
+            HerculiInstrumentation.instance().incRegionPoolCreated();
+            // Best-effort shutdown on JVM exit; server should later hook into lifecycle to call shutdown() explicitly.
+            try {
+                Runtime.getRuntime().addShutdownHook(new Thread(HerculiRegionExecutors::shutdown, "Herculi-RegionPool-Shutdown"));
+            } catch (Throwable ignored) {}
+        }
+    }
+
+    /**
+     * Serial executor that preserves FIFO order per region while executing tasks on a shared pool.
+     */
+    private static final class SerialRegionExecutor implements RegionExecutor, Executor {
+        private final Executor pool;
+        private final Queue<Runnable> queue = new ConcurrentLinkedQueue<>();
+        private volatile boolean running;
+
+        SerialRegionExecutor(final Executor pool) {
+            this.pool = pool;
+        }
+
+        @Override
+        public void execute(final Runnable task) {
+            if (task == null) return;
+            queue.add(task);
+            HerculiInstrumentation.instance().incRegionTasksEnqueued();
+            schedule();
+        }
+
+        private void schedule() {
+            if (running) return;
+            synchronized (this) {
+                if (running) return;
+                running = true;
+            }
+            pool.execute(this::drain);
+        }
+
+        private void drain() {
+            try {
+                for (;;) {
+                    Runnable r = queue.poll();
+                    if (r == null) break;
+                    try { r.run(); } catch (Throwable ignored) {} finally {
+                        HerculiInstrumentation.instance().incRegionTasksExecuted();
+                    }
+                }
+            } finally {
+                synchronized (this) {
+                    running = false;
+                    if (!queue.isEmpty()) {
+                        running = true;
+                        pool.execute(this::drain);
+                    }
+                }
+            }
+        }
+    }
+
+    /**
+     * Gracefully shutdown the region executor pool and clear per-region executors.
+     */
+    public static void shutdown() {
+        final ExecutorService p = POOL;
+        if (p != null) {
+            p.shutdownNow();
+        }
+        EXECUTORS.clear();
+    }
+}
