+package io.multipaper.herculi.region;
+
+import java.util.Objects;
+import net.minecraft.core.BlockPos;
+import net.minecraft.resources.ResourceKey;
+import net.minecraft.world.level.Level;
+
+/**
+ * Identifies a region within a specific dimension.
+ *
+ * This is scaffolding for Phase 1 and is intentionally kept minimal.
+ */
+public final class RegionKey {
+    public final ResourceKey<Level> dimension;
+    public final int rx;
+    public final int rz;
+
+    public RegionKey(final ResourceKey<Level> dimension, final int rx, final int rz) {
+        this.dimension = Objects.requireNonNull(dimension, "dimension");
+        this.rx = rx;
+        this.rz = rz;
+    }
+
+    public static RegionKey of(final ResourceKey<Level> dimension, final RegionPos pos) {
+        return new RegionKey(dimension, pos.rx, pos.rz);
+    }
+
+    public static RegionKey ofBlock(final Level level, final BlockPos pos) {
+        return of(level.dimension(), RegionPos.forBlock(pos));
+    }
+
+    @Override
+    public boolean equals(Object o) {
+        if (this == o) return true;
+        if (!(o instanceof RegionKey)) return false;
+        RegionKey regionKey = (RegionKey) o;
+        return rx == regionKey.rx && rz == regionKey.rz && dimension.equals(regionKey.dimension);
+    }
+
+    @Override
+    public int hashCode() {
+        int result = dimension.hashCode();
+        result = 31 * result + rx;
+        result = 31 * result + rz;
+        return result;
+    }
+
+    @Override
+    public String toString() {
+        return "RegionKey{" + dimension.location() + ":" + rx + "," + rz + '}';
+    }
+}
