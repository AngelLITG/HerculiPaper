+package io.multipaper.herculi.region;
+
+import net.minecraft.core.BlockPos;
+import net.minecraft.world.level.ChunkPos;
+import io.multipaper.herculi.config.HerculiConfig;
+
+/**
+ * Region position utility. Regions are power-of-two sized groups of chunks.
+ * This is a placeholder for Phase 1 scaffolding and may change during porting.
+ */
+public final class RegionPos {
+    public static final int DEFAULT_REGION_SHIFT = 4; // fallback
+
+    public final int rx;
+    public final int rz;
+
+    public RegionPos(int rx, int rz) {
+        this.rx = rx;
+        this.rz = rz;
+    }
+
+    public static RegionPos forChunk(int cx, int cz) {
+        int shift = Math.max(0, HerculiConfig.instance().threadingRegionShift());
+        return new RegionPos(cx >> shift, cz >> shift);
+    }
+
+    public static RegionPos forChunk(ChunkPos chunkPos) {
+        return forChunk(chunkPos.x, chunkPos.z);
+    }
+
+    public static RegionPos forBlock(BlockPos pos) {
+        // Convert to chunk coords first, then to region
+        int cx = pos.getX() >> 4;
+        int cz = pos.getZ() >> 4;
+        return forChunk(cx, cz);
+    }
+
+    @Override
+    public boolean equals(Object o) {
+        if (this == o) return true;
+        if (!(o instanceof RegionPos)) return false;
+        RegionPos that = (RegionPos) o;
+        return rx == that.rx && rz == that.rz;
+    }
+
+    @Override
+    public int hashCode() {
+        int result = rx;
+        result = 31 * result + rz;
+        return result;
+    }
+
+    @Override
+    public String toString() {
+        return "RegionPos{" + "rx=" + rx + ", rz=" + rz + '}';
+    }
+}
