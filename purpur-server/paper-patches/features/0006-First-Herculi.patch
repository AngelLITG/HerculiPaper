@@ -0,0 +1,49 @@
+package io.multipaper.herculi.threading;
+
+import io.multipaper.herculi.config.HerculiConfig;
+import org.bukkit.Bukkit;
+import org.bukkit.entity.Player;
+
+/**
+ * Command marshalling helper. In Phase 1 this is a thin facade that
+ * ensures execution on a safe thread when commands target a specific player.
+ *
+ * Future phases will route to that player's region executor.
+ */
+public final class CommandMarshal {
+    private CommandMarshal() {}
+
+    /**
+     * Run the given task for a target player, honoring the config flag
+     * commands.marshalPerTarget. For now, this schedules on the main thread
+     * if not already there.
+     */
+    public static void forPlayer(Player target, Runnable task) {
+        if (task == null) return;
+        if (!HerculiConfig.instance().marshalPerTarget()) {
+            task.run();
+            return;
+        }
+        // Maintain synchronous semantics on main thread for command handlers
+        if (Bukkit.isPrimaryThread()) {
+            if (HerculiConfig.instance().marshalDebug()) {
+                Bukkit.getLogger().info("[Herculi] CommandMarshal: main-thread inline for target=" + (target != null ? target.getName() : "<null>"));
+            }
+            task.run();
+            return;
+        }
+        // Off-main: route to region executor then bounce to Bukkit main for safety
+        try {
+            if (HerculiConfig.instance().marshalDebug()) {
+                Bukkit.getLogger().info("[Herculi] CommandMarshal: routing via region executor for target=" + (target != null ? target.getName() : "<null>"));
+            } else {
+                Bukkit.getLogger().fine(() -> "[Herculi] CommandMarshal: routing via region executor for target=" + (target != null ? target.getName() : "<null>"));
+            }
+            RegionSchedulers.executeForThenMain(target, task);
+        } catch (Throwable t) {
+            // Fallback: ensure main-thread execution
+            Bukkit.getLogger().warning("[Herculi] CommandMarshal: region route failed, falling back to main: " + t);
+            Bukkit.getScheduler().runTask(Bukkit.getPluginManager().getPlugins()[0], task);
+        }
+    }
+}
