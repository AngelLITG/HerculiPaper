+    private boolean handleMpmapCommand(CommandSender sender, String[] args) {
+        try {
+            org.bukkit.entity.Player player = null;
+            if (sender instanceof org.bukkit.entity.Player) {
+                player = (org.bukkit.entity.Player) sender;
+            } else if (args.length >= 2) {
+                player = org.bukkit.Bukkit.getPlayer(args[1]);
+                if (player == null) {
+                    sendErrorMessage(sender, "Player '" + args[1] + "' not found.");
+                    return true;
+                }
+            } else {
+                sendUsageMessage(sender, "/herculi mpmap [player]");
+                return true;
+            }
+            
+            org.bukkit.World world = player.getWorld();
+            org.bukkit.Location loc = player.getLocation();
+            // Bukkit Location has no direct getChunkX/Z; derive from block coordinates
+            int centerX = loc.getBlockX() >> 4;
+            int centerZ = loc.getBlockZ() >> 4;
+            int radius = 8; // Show 17x17 chunk area
+            
+            Component mapHeader = Component.text("[Herculi] ", NamedTextColor.GOLD, TextDecoration.BOLD)
+                .append(Component.text("Region/Chunk Map", NamedTextColor.AQUA, TextDecoration.UNDERLINED))
+                .append(Component.text("\nPlayer: ", NamedTextColor.YELLOW))
+                .append(Component.text(player.getName(), NamedTextColor.WHITE))
+                .append(Component.text(" | World: ", NamedTextColor.YELLOW))
+                .append(Component.text(world.getName(), NamedTextColor.WHITE))
+                .append(Component.text("\nCenter: ", NamedTextColor.YELLOW))
+                .append(Component.text("(" + centerX + ", " + centerZ + ")", NamedTextColor.WHITE))
+                .append(Component.text("\n\nLegend: ", NamedTextColor.GOLD))
+                .append(Component.text("█", NamedTextColor.GREEN))
+                .append(Component.text("=Loaded ", NamedTextColor.WHITE))
+                .append(Component.text("█", NamedTextColor.YELLOW))
+                .append(Component.text("=Loading ", NamedTextColor.WHITE))
+                .append(Component.text("█", NamedTextColor.RED))
+                .append(Component.text("=Unloaded ", NamedTextColor.WHITE))
+                .append(Component.text("█", NamedTextColor.LIGHT_PURPLE))
+                .append(Component.text("=Player ", NamedTextColor.WHITE))
+                .append(Component.text("\n"));
+            sender.sendMessage(mapHeader);
+            
+            // Generate the map
+            for (int z = centerZ - radius; z <= centerZ + radius; z++) {
+                Component line = Component.empty();
+                for (int x = centerX - radius; x <= centerX + radius; x++) {
+                    NamedTextColor color;
+                    String symbol;
+                    
+                    if (x == centerX && z == centerZ) {
+                        // Player position
+                        color = NamedTextColor.LIGHT_PURPLE;
+                        symbol = "@";
+                    } else {
+                        // Check chunk status
+                        boolean isLoaded = world.isChunkLoaded(x, z);
+                        if (isLoaded) {
+                            color = NamedTextColor.GREEN;
+                            symbol = "+";
+                        } else {
+                            color = NamedTextColor.RED;
+                            symbol = "-";
+                        }
+                    }
+                    
+                    line = line.append(Component.text(symbol, color));
+                }
+                sender.sendMessage(line);
+            }
+            
+            Component mapFooter = Component.text("\nRegion info: ", NamedTextColor.YELLOW)
+                .append(Component.text("(" + (centerX >> 5) + ", " + (centerZ >> 5) + ")", NamedTextColor.WHITE))
+                .append(Component.text(" | Chunks shown: ", NamedTextColor.YELLOW))
+                .append(Component.text(String.valueOf((radius * 2 + 1) * (radius * 2 + 1)), NamedTextColor.WHITE));
+            sender.sendMessage(mapFooter);
+            
+        } catch (Throwable t) {
+            sendErrorMessage(sender, "Mpmap unavailable: " + t.getClass().getSimpleName());
+        }
+        return true;
+    }
 
