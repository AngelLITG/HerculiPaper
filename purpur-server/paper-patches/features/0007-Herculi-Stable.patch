diff --git a/src/main/java/io/multipaper/herculi/broadcast/BroadcastRegistry.java b/src/main/java/io/multipaper/herculi/broadcast/BroadcastRegistry.java
index 93f3e76e3d50a60d9032b0d9ba20e19b6e926b7f..7a6eabfe6e31075224a0459b510b33d7fae81439 100644
--- a/src/main/java/io/multipaper/herculi/broadcast/BroadcastRegistry.java
+++ b/src/main/java/io/multipaper/herculi/broadcast/BroadcastRegistry.java
@@ -30,4 +30,29 @@ public final class BroadcastRegistry {
 
     public static boolean enabled() { return enabled; }
     public static int drainBudget() { return drainBudget; }
+
+    /**
+     * Drain queued broadcast batches on the main thread.
+     * This should be invoked once per tick from the server loop.
+     */
+    public static int drainOnMainTick(final net.minecraft.server.MinecraftServer server) {
+        if (!enabled()) return 0;
+        final var list = server.getPlayerList();
+        return manager().drainOnMain((key, batch) -> {
+            try {
+                if (key == null || batch == null) return Boolean.FALSE;
+                final net.minecraft.server.level.ServerPlayer player = list.getPlayer(key.playerUuid);
+                if (player == null || player.connection == null) {
+                    // recipient gone, remove queue lazily
+                    return Boolean.FALSE;
+                }
+                for (net.minecraft.network.protocol.Packet<?> pkt : batch.packets) {
+                    if (pkt != null) player.connection.send(pkt);
+                }
+                return Boolean.TRUE;
+            } catch (Throwable ignored) {
+                return Boolean.FALSE;
+            }
+        }, drainBudget());
+    }
 }
diff --git a/src/main/java/io/multipaper/herculi/concurrent/WeakSeqLock.java b/src/main/java/io/multipaper/herculi/concurrent/WeakSeqLock.java
new file mode 100644
index 0000000000000000000000000000000000000000..304f5ec0f458039e656aeb63c111cb89bc1e5a33
--- /dev/null
+++ b/src/main/java/io/multipaper/herculi/concurrent/WeakSeqLock.java
@@ -0,0 +1,71 @@
+package io.multipaper.herculi.concurrent;
+
+import java.lang.invoke.MethodHandles;
+import java.lang.invoke.VarHandle;
+
+/**
+ * Weak seqlock for multi-writer/multi-reader scenarios where readers can tolerate
+ * occasional retries and writers are rare/short. Writers increment a version before
+ * and after the critical section. Readers snapshot data while the version is even
+ * and retry if version changed to ensure a consistent view without locking.
+ *
+ * This is a weak seqlock: it does not block writers or readers, and should only
+ * be used for protecting small, quickly-copied snapshots.
+ */
+public final class WeakSeqLock {
+    private volatile int version; // even == stable, odd == writer in progress
+
+    private static final VarHandle VERSION_HANDLE;
+    static {
+        try {
+            VERSION_HANDLE = MethodHandles.lookup().findVarHandle(WeakSeqLock.class, "version", int.class);
+        } catch (ReflectiveOperationException e) {
+            throw new ExceptionInInitializerError(e);
+        }
+    }
+
+    public WeakSeqLock() {
+        this.version = 0;
+    }
+
+    /**
+     * Begin a write section. Multiple nested begin/end on same thread are allowed but discouraged.
+     */
+    public void beginWrite() {
+        // increment to odd using release semantics
+        int v = (int) VERSION_HANDLE.getAcquire(this);
+        VERSION_HANDLE.setRelease(this, v + 1);
+    }
+
+    /**
+     * End a write section.
+     */
+    public void endWrite() {
+        int v = (int) VERSION_HANDLE.getAcquire(this);
+        VERSION_HANDLE.setRelease(this, v + 1);
+    }
+
+    /**
+     * Returns a stamp to validate a read snapshot. Only valid if even.
+     */
+    public int tryReadBegin() {
+        int v;
+        // acquire to observe prior writes
+        do {
+            v = (int) VERSION_HANDLE.getAcquire(this);
+            if ((v & 1) == 0) {
+                return v;
+            }
+            // writer in progress, spin briefly
+        } while ((v & 1) != 0);
+        return v;
+    }
+
+    /**
+     * Returns true if the passed stamp is still valid (no writer intervened).
+     */
+    public boolean tryReadValidate(int stamp) {
+        // load acquire to see writer's endWrite
+        return stamp == (int) VERSION_HANDLE.getAcquire(this) && (stamp & 1) == 0;
+    }
+}
