diff --git a/src/main/java/ca/spottedleaf/moonrise/common/util/TickThread.java b/src/main/java/ca/spottedleaf/moonrise/common/util/TickThread.java
index 69cdd304d255d52c9b7dc9b6a33ffdb630b79abe..71683a5f4796509726d3788764e6aecd130932ec 100644
--- a/src/main/java/ca/spottedleaf/moonrise/common/util/TickThread.java
+++ b/src/main/java/ca/spottedleaf/moonrise/common/util/TickThread.java
@@ -14,6 +14,17 @@ import java.util.concurrent.atomic.AtomicInteger;
 public class TickThread extends Thread {
 
     private static final Logger LOGGER = LoggerFactory.getLogger(TickThread.class);
+    
+    // Herculi: Allow parallel entity ticking on region threads
+    private static final ThreadLocal<Boolean> HERCULI_PARALLEL_ENTITY_TICK = ThreadLocal.withInitial(() -> Boolean.FALSE);
+    
+    public static void setHerculiParallelEntityTick(boolean value) {
+        HERCULI_PARALLEL_ENTITY_TICK.set(value);
+    }
+    
+    public static boolean isHerculiParallelEntityTick() {
+        return HERCULI_PARALLEL_ENTITY_TICK.get();
+    }
 
     private static String getThreadContext() {
         return "thread=" + Thread.currentThread().getName();
@@ -119,6 +130,10 @@ public class TickThread extends Thread {
     }
 
     public static boolean isTickThread() {
+        // Herculi: Allow region threads during parallel entity ticking
+        if (isHerculiParallelEntityTick()) {
+            return true;
+        }
         return Thread.currentThread() instanceof TickThread;
     }
 
