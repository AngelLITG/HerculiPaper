diff --git a/src/main/java/io/multipaper/herculi/instrumentation/HerculiBlockEntityMetrics.java b/src/main/java/io/multipaper/herculi/instrumentation/HerculiBlockEntityMetrics.java
index 392230a07243896ab72b8e8ba201931e1d11f40e..10c78d1e89348273127ecf9c40a12f62128ceac6 100644
--- a/src/main/java/io/multipaper/herculi/instrumentation/HerculiBlockEntityMetrics.java
+++ b/src/main/java/io/multipaper/herculi/instrumentation/HerculiBlockEntityMetrics.java
@@ -6,11 +6,22 @@ public final class HerculiBlockEntityMetrics {
     private static final AtomicLong count = new AtomicLong();
     private static final AtomicLong nanosTotal = new AtomicLong();
     private static final AtomicLong nanosMax = new AtomicLong();
+    
+    // Herculi: Sampling to reduce overhead - only measure 1% of ticks
+    private static final ThreadLocal<Integer> sampleCounter = ThreadLocal.withInitial(() -> 0);
 
     private HerculiBlockEntityMetrics() {}
 
     public static long start() {
-        return System.nanoTime();
+        // Sample only 1% of ticks to reduce overhead
+        int sampleRate = io.multipaper.herculi.config.HerculiConfig.instance().instrumentationSampleRate();
+        int counter = sampleCounter.get() + 1;
+        if (counter >= sampleRate) {
+            sampleCounter.set(0);
+            return System.nanoTime(); // Measure this tick
+        }
+        sampleCounter.set(counter);
+        return 0L; // Skip measurement
     }
 
     public static void end(long startNanoTime) {
