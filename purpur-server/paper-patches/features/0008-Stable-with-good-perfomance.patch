 public final class RegionSchedulers {
-    private static final class Holder {
-        final ExecutorService executor;
+    private static final class SerialRegionExecutor implements Executor {
+        private final Executor pool;
+        private final java.util.Queue<Runnable> queue = new java.util.concurrent.ConcurrentLinkedQueue<>();
+        private volatile boolean running;
         volatile long lastUsedMillis;
-        Holder(ExecutorService ex, long ts) { this.executor = ex; this.lastUsedMillis = ts; }
+        SerialRegionExecutor(final Executor pool) { this.pool = pool; this.lastUsedMillis = System.currentTimeMillis(); }
+        @Override
+        public void execute(Runnable command) {
+            if (command == null) return;
+            queue.add(command);
+            schedule();
+        }
+        private void schedule() {
+            if (running) return;
+            synchronized (this) {
+                if (running) return;
+                running = true;
+            }
+            pool.execute(this::drain);
+        }
+        private void drain() {
+            try {
+                for (;;) {
+                    final Runnable r = queue.poll();
+                    if (r == null) break;
+                    try { r.run(); } catch (Throwable ignored) {}
+                }
+            } finally {
+                synchronized (this) {
+                    running = false;
+                    if (!queue.isEmpty()) {
+                        running = true;
+                        pool.execute(this::drain);
+                    }
+                }
+            }
+        }
     }
 
