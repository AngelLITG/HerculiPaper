+    /**
+     * Compute a value on the player's region thread, then consume it on the Bukkit main thread.
+     */
+    public static <T> void supplyForThenMain(Player player, java.util.function.Supplier<T> supplier, java.util.function.Consumer<T> consumer) {
+        Objects.requireNonNull(supplier, "supplier");
+        Objects.requireNonNull(consumer, "consumer");
+        executeFor(player, () -> {
+            final T result;
+            try {
+                result = supplier.get();
+            } catch (Throwable t) {
+                // Swallow and pass null to consumer to indicate failure
+                consumer.accept(null);
+                return;
+            }
+            Runnable deliver = () -> consumer.accept(result);
+            if (Bukkit.isPrimaryThread()) {
+                deliver.run();
+            } else {
+                Bukkit.getScheduler().runTask(Bukkit.getPluginManager().getPlugins()[0], deliver);
+            }
+        });
+    }
+
     private static void sweepIdleExecutors() {
         final long idleMillis = TimeUnit.MINUTES.toMillis(HerculiConfig.instance().threadingRegionExecutorIdleMinutes());
         final long now = System.currentTimeMillis();
-        for (Map.Entry<Long, Holder> e : EXECUTORS.entrySet()) {
-            Holder h = e.getValue();
+        for (Map.Entry<Long, SerialRegionExecutor> e : EXECUTORS.entrySet()) {
+            SerialRegionExecutor h = e.getValue();
             if (now - h.lastUsedMillis > idleMillis) {
-                if (EXECUTORS.remove(e.getKey(), h)) {
-                    try { h.executor.shutdown(); } catch (Throwable ignored) {}
-                }
+                EXECUTORS.remove(e.getKey(), h);
             }
         }
     }
