+                .append(Component.text("Thread Status", NamedTextColor.AQUA, TextDecoration.UNDERLINED))
+                .append(Component.text("\n• GlobalTickThread: ", NamedTextColor.YELLOW))
+                .append(Component.text(String.valueOf(global), global ? NamedTextColor.GREEN : NamedTextColor.RED));
+            if (sender instanceof Player) {
+                Player p = (Player) sender;
+                Location loc = p.getLocation();
+                boolean owned = org.bukkit.Bukkit.getServer().isOwnedByCurrentRegion(loc);
+                base = base
+                    .append(Component.text("\n• OwnedByCurrentRegion: ", NamedTextColor.YELLOW))
+                    .append(Component.text(String.valueOf(owned), owned ? NamedTextColor.GREEN : NamedTextColor.RED))
