+    private boolean handleSoundCommand(CommandSender sender, String[] args) {
+        try {
+            Player target = null;
+            int idx = 1;
+            if (sender instanceof Player) {
+                target = (Player) sender;
+            }
+            if (args.length >= 2) {
+                Player p = org.bukkit.Bukkit.getPlayer(args[1]);
+                if (p != null) { target = p; idx = 2; }
+            }
+            if (target == null) {
+                sendUsageMessage(sender, "/herculi sound [player] [soundNameOrKey] [volume] [pitch]");
+                return true;
+            }
+            String soundKey = (args.length > idx) ? args[idx] : "entity.experience_orb.pickup";
+            float volume = (args.length > idx + 1) ? parseFloat(args[idx + 1], 1.0f) : 1.0f;
+            float pitch  = (args.length > idx + 2) ? parseFloat(args[idx + 2], 1.0f) : 1.0f;
+            Location loc = target.getLocation();
+            // Try enum first
+            boolean sent = false;
+            try {
+                Sound s = Sound.valueOf(soundKey.toUpperCase(java.util.Locale.ROOT));
+                target.playSound(loc, s, SoundCategory.MASTER, volume, pitch);
+                sent = true;
+            } catch (IllegalArgumentException ignored) {}
+            if (!sent) {
+                target.playSound(loc, soundKey, SoundCategory.MASTER, volume, pitch);
+            }
+            sendSuccessMessage(sender, "Played sound '" + soundKey + "' to " + target.getName() + ".");
+        } catch (Throwable t) {
+            sendErrorMessage(sender, "Sound test failed: " + t.getClass().getSimpleName());
+        }
+        return true;
+    }
