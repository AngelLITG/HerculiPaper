+    private boolean herculi$spawnNearFallback = false;
+
+    // Build the set of chunks near players once per game tick using per-player spawn radius
+    private void herculi$ensureSpawnNearBuilt() {
+        final long tick = this.level.getGameTime();
+        if (this.herculi$spawnNearBuiltTick == tick) {
+            return;
+        }
+        this.herculi$spawnNearChunks.clear();
+        this.herculi$spawnNearFallback = false;
+        // Iterate all players; respect PlayerNaturallySpawnCreaturesEvent
+        final java.util.List<ServerPlayer> players = this.level.players();
+        // Quick estimate to avoid O(players * r^2) explosion: cap total inserts
+        long estimatedCells = 0L;
+        for (int i = 0, len = players.size(); i < len; ++i) {
+            final ServerPlayer p = players.get(i);
+            final com.destroystokyo.paper.event.entity.PlayerNaturallySpawnCreaturesEvent ev = p.playerNaturallySpawnedEvent;
+            if (ev == null || ev.isCancelled()) continue;
+            final long r = Math.max(0, ev.getSpawnRadius());
+            estimatedCells += (2L * r + 1L) * (2L * r + 1L);
+            if (estimatedCells > 150_000L) { // safety cap
+                this.herculi$spawnNearFallback = true;
+                this.herculi$spawnNearBuiltTick = tick;
+                return;
+            }
+        }
+        for (int i = 0, len = players.size(); i < len; ++i) {
+            final ServerPlayer p = players.get(i);
+            final com.destroystokyo.paper.event.entity.PlayerNaturallySpawnCreaturesEvent event = p.playerNaturallySpawnedEvent;
+            if (event == null || event.isCancelled()) {
+                continue;
+            }
+            final int radiusChunks = Math.max(0, event.getSpawnRadius());
+            final int pcx = p.getBlockX() >> 4;
+            final int pcz = p.getBlockZ() >> 4;
+            final int minX = pcx - radiusChunks;
+            final int maxX = pcx + radiusChunks;
+            final int minZ = pcz - radiusChunks;
+            final int maxZ = pcz + radiusChunks;
+            for (int x = minX; x <= maxX; ++x) {
+                for (int z = minZ; z <= maxZ; ++z) {
+                    this.herculi$spawnNearChunks.add(ChunkPos.asLong(x, z));
+                }
+            }
+        }
+        this.herculi$spawnNearBuiltTick = tick;
+    }
