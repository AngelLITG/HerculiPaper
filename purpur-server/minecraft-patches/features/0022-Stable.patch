+    /**
+     * Snapshot players in the given chunk and map type into a new array sized to the current list.
+     * Intended for main-thread use. Returns an empty array if none.
+     */
+    public ServerPlayer[] snapshotPlayersByChunk(final int chunkX, final int chunkZ, final NearbyMapType type) {
+        final ReferenceList<ServerPlayer> list = this.directByChunk[type.ordinal()].get(CoordinateUtils.getChunkKey(chunkX, chunkZ));
+        if (list == null) return new ServerPlayer[0];
+        final Object[] raw = list.getRawData();
+        final int size = list.size();
+        final ServerPlayer[] out = new ServerPlayer[size];
+        for (int i = 0; i < size; i++) {
+            out[i] = (ServerPlayer) raw[i];
+        }
+        return out;
+    }
+
+    /**
+     * Fast foreach over players in a given chunk and map type without allocations.
+     * Captures a size snapshot and iterates the backing array directly.
+     */
+    public void forEachByChunk(final int chunkX, final int chunkZ, final NearbyMapType type, final java.util.function.Consumer<ServerPlayer> action) {
+        final ReferenceList<ServerPlayer> list = this.directByChunk[type.ordinal()].get(CoordinateUtils.getChunkKey(chunkX, chunkZ));
+        if (list == null) return;
+        final Object[] raw = list.getRawData();
+        final int size = list.size();
+        for (int i = 0; i < size; i++) {
+            action.accept((ServerPlayer) raw[i]);
+        }
+    }
