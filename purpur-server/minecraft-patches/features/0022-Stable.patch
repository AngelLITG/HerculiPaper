--- /dev/null
+++ b/io/papermc/paper/PotentialHooks.java
@@ -0,0 +1,29 @@
+package io.papermc.paper;
+
+public final class PotentialHooks {
+    private PotentialHooks() {}
+
+    private static volatile boolean ENABLED = false;
+    private static volatile int SIZE = 4096; // must be power-of-two; will be clamped by setter
+
+    private static final java.util.concurrent.atomic.AtomicLong HITS = new java.util.concurrent.atomic.AtomicLong();
+    private static final java.util.concurrent.atomic.AtomicLong MISSES = new java.util.concurrent.atomic.AtomicLong();
+
+    public static void setEnabled(boolean enabled, int size) {
+        ENABLED = enabled;
+        SIZE = Math.max(64, highestPowerOfTwo(Math.min(Math.max(size, 64), 1 << 20))); // clamp 64..1M and pow2
+    }
+
+    public static boolean isEnabled() { return ENABLED; }
+    public static int cacheSize() { return SIZE; }
+
+    public static void incHit() { HITS.incrementAndGet(); }
+    public static void incMiss() { MISSES.incrementAndGet(); }
+    public static long getHits() { return HITS.get(); }
+    public static long getMisses() { return MISSES.get(); }
+
+    private static int highestPowerOfTwo(int v) {
+        // Round down to highest power-of-two
+        return Integer.highestOneBit(v);
+    }
+}
