diff --git a/ca/spottedleaf/moonrise/patches/chunk_system/level/entity/EntityLookup.java b/ca/spottedleaf/moonrise/patches/chunk_system/level/entity/EntityLookup.java
index 2d24d03bbdb5ee0d862cbfff2219f58afffafe12..136479d685654e986c4a46a3606d9ee81efeec90 100644
--- a/ca/spottedleaf/moonrise/patches/chunk_system/level/entity/EntityLookup.java
+++ b/ca/spottedleaf/moonrise/patches/chunk_system/level/entity/EntityLookup.java
@@ -179,6 +179,23 @@ public abstract class EntityLookup implements LevelEntityGetter<Entity> {
         }
     }
 
+    /**
+     * Low-allocation iteration over accessible entities. This avoids allocating a full copy
+     * by iterating the backing array under synchronization. The provided consumer must be
+     * lightweight and must not invoke operations that could re-enter into this lookup to
+     * avoid potential lock contention.
+     */
+    public void forEachAccessible(final Consumer<Entity> action) {
+        Objects.requireNonNull(action, "action");
+        synchronized (this.accessibleEntities) {
+            final Entity[] raw = this.accessibleEntities.getRawData();
+            final int size = this.accessibleEntities.size();
+            for (int i = 0; i < size; i++) {
+                action.accept(raw[i]);
+            }
+        }
+    }
+
     public Iterable<Entity> getAllMapped() {
         return this.entityByUUID.values();
     }
